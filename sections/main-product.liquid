{%- liquid
  assign zoom_size = 5000
  assign min_aspect_ratio = 0.6

  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media

  unless product.has_only_default_variant
    if section.settings.select_first_variant == false and product.variants_count > 1
      if product.selected_variant
        assign current_variant = product.selected_variant
        assign featured_media = current_variant.featured_media | default: product.featured_media
      elsif request.params.variant == blank and request.params.option_values == blank
        assign current_variant = false
        assign featured_media = product.featured_media
      endif
    endif
  endunless

  if request.params.option_values != blank and product.has_only_default_variant == false
    assign nw_option_value_ids = request.params.option_values | split: ','
    assign nw_resolved_variant_from_options = false
    for variant in product.variants
      assign nw_variant_matches_options = true
      for option in product.options_with_values
        assign nw_sel_id = nw_option_value_ids[forloop.index0] | strip
        assign nw_expected_option_value = ''
        for option_value in option.values
          assign nw_option_value_id_str = option_value.id | append: ''
          if nw_option_value_id_str == nw_sel_id
            assign nw_expected_option_value = option_value.name
            break
          endif
        endfor
        if nw_expected_option_value == blank
          assign nw_variant_matches_options = false
          break
        endif
        case option.position
          when 1
            if variant.option1 != nw_expected_option_value
              assign nw_variant_matches_options = false
            endif
          when 2
            if variant.option2 != nw_expected_option_value
              assign nw_variant_matches_options = false
            endif
          when 3
            if variant.option3 != nw_expected_option_value
              assign nw_variant_matches_options = false
            endif
        endcase
        unless nw_variant_matches_options
          break
        endunless
      endfor
      if nw_variant_matches_options
        assign current_variant = variant
        assign featured_media = variant.featured_media | default: product.featured_media
        assign nw_resolved_variant_from_options = true
        break
      endif
    endfor
    if nw_resolved_variant_from_options == false and product.selected_variant
      assign current_variant = product.selected_variant
      assign featured_media = current_variant.featured_media | default: product.featured_media
    endif
  endif

  assign nw_url_variant_valid = false
  if request.params.variant != blank and product.has_only_default_variant == false
    assign nw_requested_variant_id = request.params.variant | plus: 0
    for variant in product.variants
      if variant.id == nw_requested_variant_id
        assign current_variant = variant
        assign featured_media = variant.featured_media | default: product.featured_media
        assign nw_url_variant_valid = true
        break
      endif
    endfor
  endif

  if product.has_only_default_variant == false and request.params.option_values == blank and nw_url_variant_valid == false
    assign pref_option_1 = ''
    assign pref_option_2 = ''
    assign pref_option_3 = ''

    for option in product.options_with_values
      for value in option.values limit: 1
        case option.position
          when 1
            assign pref_option_1 = value | append: ''
          when 2
            assign pref_option_2 = value | append: ''
          when 3
            assign pref_option_3 = value | append: ''
        endcase
      endfor
    endfor

    assign first_options_variant = nil
    for variant in product.variants
      assign option_match = true
      if product.options.size > 0 and variant.option1 != pref_option_1
        assign option_match = false
      endif
      if option_match and product.options.size > 1 and variant.option2 != pref_option_2
        assign option_match = false
      endif
      if option_match and product.options.size > 2 and variant.option3 != pref_option_3
        assign option_match = false
      endif
      if option_match
        if first_options_variant == nil or variant.available
          assign first_options_variant = variant
          if variant.available
            break
          endif
        endif
      endif
    endfor

    if first_options_variant != nil
      assign current_variant = first_options_variant
      assign featured_media = current_variant.featured_media | default: product.featured_media
    endif
  endif

  assign product_form_id = 'product-form-' | append: section.id

  assign enable_media_grouping = false
  if section.settings.enable_media_grouping
    assign media_grouping_options = section.settings.media_grouping_option | replace: ', ', ',' | split: ','
    for option in product.options_with_values
      if media_grouping_options contains option.name
        assign media_grouping_option = option

        for value in option.values
          if value.variant.featured_media
            assign enable_media_grouping = true
            break
          endif
        endfor
      endif
    endfor
  endif

  assign nw_pdp_active_size = ''
  assign nw_size_links_block = section.blocks | where: 'type', 'nw-size-links' | first
  if nw_size_links_block == blank
    assign nw_size_links_block = section.blocks | where: 'type', 'nw-gender-links' | first
  endif
  assign nw_thickness_block = section.blocks | where: 'type', 'nw-thickness' | first

  if nw_size_links_block
    if nw_size_links_block.settings.mens_product != blank and product.id == nw_size_links_block.settings.mens_product.id
      assign nw_pdp_active_size = 'men'
    elsif nw_size_links_block.settings.womens_product != blank and product.id == nw_size_links_block.settings.womens_product.id
      assign nw_pdp_active_size = 'women'
    endif
  endif

  if nw_pdp_active_size == blank and nw_thickness_block
    for i in (1..5)
      case i
        when 1
          assign nw_th_mens_product = nw_thickness_block.settings.option_1_mens_product
          assign nw_th_womens_product = nw_thickness_block.settings.option_1_womens_product
        when 2
          assign nw_th_mens_product = nw_thickness_block.settings.option_2_mens_product
          assign nw_th_womens_product = nw_thickness_block.settings.option_2_womens_product
        when 3
          assign nw_th_mens_product = nw_thickness_block.settings.option_3_mens_product
          assign nw_th_womens_product = nw_thickness_block.settings.option_3_womens_product
        when 4
          assign nw_th_mens_product = nw_thickness_block.settings.option_4_mens_product
          assign nw_th_womens_product = nw_thickness_block.settings.option_4_womens_product
        when 5
          assign nw_th_mens_product = nw_thickness_block.settings.option_5_mens_product
          assign nw_th_womens_product = nw_thickness_block.settings.option_5_womens_product
      endcase
      if nw_th_mens_product != blank and product.id == nw_th_mens_product.id
        assign nw_pdp_active_size = 'men'
        break
      endif
      if nw_th_womens_product != blank and product.id == nw_th_womens_product.id
        assign nw_pdp_active_size = 'women'
        break
      endif
    endfor
  endif

  if nw_pdp_active_size == blank and nw_size_links_block
    assign nw_default_active_size = nw_size_links_block.settings.active_size
    if nw_default_active_size == blank
      assign nw_default_active_size = nw_size_links_block.settings.active_gender
    endif
    if nw_default_active_size == 'men'
      assign nw_pdp_active_size = 'men'
    else
      assign nw_pdp_active_size = 'women'
    endif
  endif

  if nw_pdp_active_size == blank
    assign nw_pdp_active_size = 'women'
  endif

-%}
{{ 'custom-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign nw_has_thickness_block = false
  assign nw_has_size_links_block = false
  for block in section.blocks
    if block.type == 'nw-thickness'
      assign nw_has_thickness_block = true
    endif
    if block.type == 'nw-size-links' or block.type == 'nw-gender-links'
      assign nw_has_size_links_block = true
    endif
  endfor
-%}
{%- if nw_has_thickness_block -%}
  <script src="{{ 'nw-thickness-picker.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if nw_has_thickness_block or nw_has_size_links_block -%}
  <script src="{{ 'nw-pdp-product-switch.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if product.media.size > 1 -%}
  <script src="{{ 'slideshow.js' | asset_url }}" defer></script>
{%- endif -%}

{% if section.settings.show_breadcrumbs %}
  <div class="container desktop-only not-in-quickbuy fade-in-up" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"', always: true -%}>
    <div class="page-header" data-dynamic-product-content="breadcrumbs">
      {% render 'breadcrumbs', show_next_prev: true %}
    </div>
  </div>
{% endif %}

<product-form id="{{ section.id }}" class="js-product product-info quickbuy-content spaced-row container">
  <media-gallery class="media-gallery media-gallery--layout-{{ section.settings.gallery_layout }} media-gallery-size-{{ section.settings.gallery_size }} product-column-left fade-in-up {% if product.media.size > 1 and section.settings.hide_product_thumbnails == false %}has-thumbnails{% endif %}"
    {%- if enable_media_grouping %}
      data-media-grouping-enabled
    {%- endif %}
    {%- if section.settings.enable_zoom %}
      data-zoom-enabled
    {%- endif %}
    {%- if settings.preload_pdp_gallery_images %}
      data-preload
    {%- endif %}
    {%- if section.settings.gallery_layout contains 'columns' or section.settings.gallery_layout contains 'collage' %}
      {%- if section.settings.collage_highlight_on_variant_change == false %}
        data-no-collage-variant-highlight
      {%- endif %}
    {%- endif %}
    data-dynamic-product-content="media-gallery-{{ section.id }}"
    {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"', always: true -%}>

    <a class="skip-link visually-hidden top-0 start-0" href="#ProductInfo-{{ section.id }}">{{ 'accessibility.skip_to_product_info' | t }}</a>

    <div class="media-gallery__inner{% if section.settings.enable_sticky_columns %} sticky-column-desktop{% endif %}">
      <div class="main-image">
        {%- liquid
          for media in product.media
            if media.id == featured_media.id
              assign initial_slide = forloop.index0
              break
            endif
          endfor
        -%}

        <carousel-slider class="{% if section.settings.gallery_layout contains 'collage' or section.settings.gallery_layout contains 'columns' %}mobile-only{% endif %}" role="region" aria-roledescription="{{ 'sections.slideshow.carousel' | t }}" aria-label="{{ section.settings.accessibility_info | escape }}" data-dynamic-height="true" data-dispatch-events="true" data-lazy="false">
          <div class="slider slider--no-scrollbar" id="slider-{{ section.id }}" aria-live="polite" aria-atomic="true">
            <div class="slider__grid">
              {%- for media in product.media -%}
                <div class="slider__item{% if forloop.index0 == initial_slide %} is-active{% endif %}"
                  role="group" aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                  {%- unless forloop.index0 == initial_slide %} tabindex="-1"{% endunless %}
                  {%- if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}
                  data-media-id="{{ media.id }}">

                  {%- if media.media_type == 'image' and section.settings.enable_zoom -%}
                    <a class="block show-gallery" href="{{ media.preview_image | image_url: width: zoom_size }}" aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}">
                  {%- endif -%}

                  {%- liquid
                    if forloop.index0 == initial_slide
                      assign loading = 'eager'
                    else
                      assign loading = 'lazy'
                    endif

                    render 'media', media: media, product: product, min_aspect_ratio: min_aspect_ratio, loading: loading
                  -%}

                  {%- if media.media_type == 'image' and section.settings.enable_zoom -%}
                    </a>
                  {%- endif -%}

                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if product.media.size > 1 and section.settings.show_gallery_arrows -%}
            <div class="slider-nav slider-nav--floating  js-only">
              <button type="button" class="slider-nav__btn slider-nav__btn--style-2 has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                {% render 'icon-chevron-left' %}
              </button>

              <button type="button" class="slider-nav__btn slider-nav__btn--style-2 has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                {% render 'icon-chevron-right' %}
              </button>
            </div>
          {%- endif -%}
        </carousel-slider>

        {%- if product.media.size > 1 and section.settings.show_gallery_dots -%}
          <div class="media-gallery-pagination js-only slideshow-pagination">
            {%- for media in product.media -%}
              <button type="button" class="page-btn" data-media-id="{{ media.id }}" aria-controls="slider-{{ section.id }}"{% if forloop.index0 == initial_slide %} aria-current="true"{% endif %}>
                <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="page-btn__circle" aria-hidden="true">
                  <circle class="page-btn__fg-circle" cx="12" cy="12" r="6" />
                  <circle class="page-btn__bg-circle" cx="12" cy="12" r="6" />
                </svg>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.gallery_layout contains 'collage' or section.settings.gallery_layout contains 'columns' -%}
          <div class="product-media-collage desktop-only">
            {%- for media in product.media -%}
              <div class="product-media-collage__item{% if forloop.index0 == initial_slide %} is-active{% endif %}" data-media-id="{{ media.id }}">
                {%- if media.media_type == 'image' and section.settings.enable_zoom -%}
                  <a class="show-gallery" href="{{ media.preview_image | image_url: width: zoom_size }}">
                {%- endif -%}
                {%- liquid
                  if forloop.index < 4
                    assign loading = 'eager'
                  else
                    assign loading = 'lazy'
                  endif

                  render 'media', media: media, product: product, min_aspect_ratio: min_aspect_ratio, loading: loading, in_collage: true
                -%}
                {%- if media.media_type == 'image' and section.settings.enable_zoom -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign models = product.media | where: 'media_type', 'model' -%}
        {% if models.size > 0 %}
          <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
          <link rel="stylesheet" href="{{ 'model-viewer.css' | asset_url }}" media="print" onload="this.media='all'">
          <script src="{{ 'product-model.js' | asset_url }}" defer></script>

          <script type="application/json" id="product-json-models-{{ product.id }}">
            {{- product.media | where: 'media_type', 'model' | json -}}
          </script>

          <button
            class="view-in-space btn"
            data-shopify-xr
            data-shopify-model3d-id="{{ models.first.id }}"
            data-shopify-title="{{ product.title | escape }}"
            data-shopify-xr-hidden>
            {%- render 'icon-3d-badge-full-color' -%}
            <span class="view-in-space__text">{{ 'products.product.xr_button' | t }}</span>
          </button>
        {% endif %}

        {% render 'product-label-detail', product: product, current_variant: current_variant %}
      </div>

      {% if product.media.size > 1 and section.settings.hide_product_thumbnails == false %}
        <carousel-slider class="carousel block thumbnails{% unless section.settings.gallery_layout contains 'carousel' %} mobile-only{% endunless %}">
          <div class="slider slider--no-scrollbar">
            <ul class="slider__grid">
              {% for media in product.media %}
                <li class="slider__item{% if forloop.index0 == initial_slide %} is-active{% endif %}" data-media-id="{{ media.id }}">
                  <a class="thumbnail thumbnail--media-{{ media.media_type }}" href="{% if section.settings.enable_zoom %}{{ media.preview_image | image_url: width: zoom_size }}{% else %}#{% endif %}">
                    {%- liquid
                      assign custom_aspect_ratio = media.preview_image.aspect_ratio | at_least: min_aspect_ratio
                      render 'image' with media.preview_image, sizes: '65px', widths: '65px, 130px', custom_aspect_ratio: custom_aspect_ratio, custom_crop: 'contain'
                    -%}

                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <div class="thumbnail__badge">
                        {% render 'icon-video-badge-full-color' %}
                      </div>
                    {%- endif -%}
                    {%- if media.media_type == 'model' -%}
                      <div class="thumbnail__badge">
                        {% render 'icon-3d-badge-full-color' %}
                      </div>
                    {%- endif -%}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </carousel-slider>
      {% endif %}
    </div>

    {%- if section.settings.enable_zoom -%}
      {%- render 'gallery-viewer', product: product, zoom_size: zoom_size -%}
    {%- endif -%}

    {%- if enable_media_grouping -%}
      <script class="js-data-variant-media" type="application/json">
        {
          "groupOptionName": {{- media_grouping_option.name | json -}},
          "groupOptionIndex": {{- media_grouping_option.position | minus: 1 }},
          "media": {
            {%- assign standard_media_found = false -%}
            {%- for media in product.media -%}
              {%- liquid
                for value in media_grouping_option.values
                  if value.variant and value.variant.featured_media.id == media.id
                    assign current_group = value.name
                  endif
                endfor
                unless media.alt contains 'all-groups'
                  assign standard_media_found = true
                endunless
              -%}
              {%- unless forloop.first -%},{%- endunless -%}
              "{{ media.id }}": {
                {%- if media.alt contains 'all-groups' -%}
                  "group": true, "position": "{% if standard_media_found %}end{% else %}start{% endif %}"
                {%- else -%}
                  "group": {{ current_group | json }}
                {%- endif -%}
              }
            {%- endfor -%}
          }
        }
      </script>
    {%- endif -%}
  </media-gallery>

  <div class="detail product-column-right fade-in-up" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"', always: true -%}>
    {%- if section.settings.enable_sticky_columns -%}
      <script src="{{ 'sticky-scroll.js' | asset_url }}" defer></script>
      <sticky-scroll class="block sticky-column-desktop">
    {%- endif -%}

    <div class="product-form" id="ProductInfo-{{ section.id }}">
      {%- if section.settings.enable_sticky_atc -%}
        <a class="sticky-atc-anchor" id="product-info" rel="nofollow"></a>
      {%- endif -%}
      {% for block in section.blocks %}
        
        {%- capture nw_pdp_block_animate -%}
          {%- render 'nw-pdp-block-animate', block: block,  -%}
        {%- endcapture -%}
        {% case block.type %}
          {% when '@app' %}
            <div class="{% unless settings.qb_show_app_blocks %}not-in-quickbuy{% endunless %} fade-in-up"{{- nw_pdp_block_animate -}}>
              {% render block %}
            </div>

          {% when 'title' %}
            <div class="title-row fade-in-up" data-dynamic-variant-content="{{ block.id }}"
              {%- if block.settings.custom_title != blank -%}
                data-nw-title-template='{{ block.settings.custom_title | json }}'
              {%- endif -%}
              {{- nw_pdp_block_animate -}}>
              <h1 class="product-title">
                {%- if block.settings.custom_title != blank -%}
                  {%- render 'nw-product-custom-title', custom_title: block.settings.custom_title, product: product, current_variant: current_variant -%}
                {%- else -%}
                  {{- product.title | escape -}}
                {%- endif -%}
              </h1>
            </div>

          {% when 'price' %}
            <div class="price-container fade-in-up"{{- nw_pdp_block_animate -}}>
              <div class="product-info__price product-price product-price--large" role="status" data-dynamic-variant-content="{{ block.id }}-price">
                {% render 'price', product: product, show_currency_code: settings.product_currency_code_enabled, for_variant_picker: true, current_variant: current_variant %}
              </div>

              <div class="price-descriptors">
                {%- if block.settings.show_installments -%}
                  {%- form 'product', product, class: 'js-instalments-form' -%}
                    <input type="hidden" name="id" value="{% if current_variant %}{{ current_variant.id }}{% endif %}" data-dynamic-variant-content="{{ block.id }}-instalments">
                    {{ form | payment_terms }}
                  {%- endform -%}
                {%- endif -%}

                {%- if block.settings.show_tax_and_shipping -%}
                  {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="product-policies" data-dynamic-product-content="{{ block.id }}-policies">
                      {%- if cart.taxes_included -%}
                        {{ 'products.product.include_taxes' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}

                {% if section.settings.inventory_transfers_enable %}
                  <div class="product-inventory-transfer"{% unless current_variant and current_variant.incoming %} hidden{% endunless %} data-dynamic-variant-content="{{ block.id }}-transfers">
                    {%- liquid
                      if current_variant.next_incoming_date
                        assign date = current_variant.next_incoming_date | date: format: 'date'
                        if current_variant.available
                          assign incoming_html = 'products.transfers.will_not_ship_until' | t: date: date
                        else
                          assign incoming_html = 'products.transfers.will_be_in_stock_after' | t: date: date
                        endif
                      else
                        assign incoming_html = 'products.transfers.waiting_for_stock' | t
                      endif
                    -%}
                    {{- incoming_html -}}
                  </div>
                {% endif %}
              </div>

              {%- if block.settings.enable_product_reviews_by_price -%}
                <div {% if product.metafields.reviews.rating_count == blank %} hidden{% endif %} data-dynamic-variant-content="{{ block.id }}-reviews-by-price">
                  {%- assign rating_count = product.metafields.reviews.rating_count | plus: 0 -%}
                  {%- if rating_count > 0 -%}
                    <div class="theme-product-reviews">
                      {% render 'rating', rating_value: product.metafields.reviews.rating.value %}
                      <span class="cc-rating-custom-caption">
                        {{- 'products.product.reviews_count' | t: count: rating_count -}}
                      </span>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {% when 'description' %}
            <div class="not-in-quickbuy{% if block.settings.show_in_tab %} product-info-accordion{% endif %} fade-in-up"
                  data-dynamic-variant-content="{{ block.id }}"
                  {%- if product.description == blank %} hidden{% endif %}
                  {{- nw_pdp_block_animate -}}>
              {% if block.settings.show_in_tab %}
                <details-disclosure>
                  <details class="disclosure"{% if block.settings.open_tab %} open{% endif %}>
                    <summary class="disclosure__title">
                      {%- if block.settings.icon == blank -%}
                        {{- 'products.product.description' | t -}}
                      {%- else -%}
                        <div class="with-icon">
                          {% render 'icon', icon: block.settings.icon, size: 'small' %}
                          <span class="with-icon__beside">{{ 'products.product.description' | t }}</span>
                        </div>
                      {%- endif -%}
                    </summary>
                    <div class="disclosure__panel has-motion">
                      <div class="disclosure__content rte cf">
                        {{- product.description -}}
                      </div>
                    </div>
                  </details>
                </details-disclosure>
              {% else %}
                <div class="product-description rte cf">
                  {%- if block.settings.icon == blank -%}
                    {{- product.description -}}
                  {%- else -%}
                    <div class="with-icon">
                      {% render 'icon', icon: block.settings.icon, size: 'small' %}
                      <span class="with-icon__beside">{{ product.description }}</span>
                    </div>
                  {%- endif -%}
                </div>
              {% endif %}
            </div>

          {% when 'vendor' %}
            {%- liquid
              assign product_vendor_handle = product.vendor | handle
              if collections[product_vendor_handle].handle == product_vendor_handle
                assign vendor_url = collections[product_vendor_handle].url
              else
                assign vendor_url = product.vendor | url_for_vendor
              endif
            -%}
            <div class="vendor lightly-spaced-row fade-in-up"{{- nw_pdp_block_animate -}}>
              <span class="product-info-label">{{ 'products.product.vendor' | t }}</span> {{ product.vendor | link_to: vendor_url, class: 'underline' }}
            </div>

          {% when 'sku' %}
            <div class="product-sku fade-in-up"{% if current_variant == blank or current_variant.sku == blank %} hidden{% endif %} data-dynamic-variant-content="{{ block.id }}"{{- nw_pdp_block_animate -}}>
              <span class="product-info-label">{{ 'products.product.sku' | t }}</span> <span class="product-sku__value">{% if current_variant %}{{ current_variant.sku }}{% endif %}</span>
            </div>

          {% when 'barcode' %}
            <div class="product-barcode fade-in-up"{% if current_variant == blank or current_variant.barcode == blank %} hidden{% endif %} data-dynamic-variant-content="{{ block.id }}"{{- nw_pdp_block_animate -}}>
              <span class="product-info-label">{{ 'products.product.barcode' | t }}</span> <span class="product-barcode__value">{% if current_variant %}{{ current_variant.barcode }}{% endif %}</span>
            </div>

          {% when 'variant-picker' %}
            <div class="input-row variant-picker-row fade-in-up" data-dynamic-variant-content="{{ block.id }}"{% if product.has_only_default_variant %} hidden{% endif %}{{- nw_pdp_block_animate -}}>
              {%- capture size_chart_link -%}
                {%- if block.settings.enable_size_chart -%}
                  {%- if block.settings.size_chart_source == 'section' or block.settings.size_chart_page != blank -%}
                    <script src="{{ 'open-or-scroll-to.js' | asset_url }}" defer></script>
                    <open-or-scroll-to data-target-id="size-chart-{{ product.id }}">
                      <button type="button" class="link block text-sm size-chart-link">
                        <span class="size-chart-link__text">{{- block.settings.size_chart_label -}}</span>
                        <span class="size-chart-link__icon">{{ 'icon-right.svg' | inline_asset_content }}</span>
                      </button>
                    </open-or-scroll-to>
                  {%- endif -%}
                {%- endif -%}
              {%- endcapture -%}
              {% render 'variant-picker',
                product: product,
                current_variant: current_variant,
                product_form_id: product_form_id,
                block: block,
                update_url: true,
                size_chart_link: size_chart_link,
                media_ratio: 1
              %}
            </div>

          {% when 'buy-buttons' %}
            <div class="input-row buy-buttons-row fade-in-up"{{- nw_pdp_block_animate -}}>
              {% form 'product', product, id: product_form_id, class: 'form js-product-form', data-product-id: product.id %}
                <input type="hidden" name="id" value="{% if current_variant %}{{ current_variant.id }}{% endif %}" required data-dynamic-variant-content="{{ block.id }}-input-id">

                {%- liquid
                  assign gift_card_recipient_feature_active = false
                  if block.settings.show_gift_card_recipient and product.gift_card?
                    assign gift_card_recipient_feature_active = true
                  endif

                  assign enable_dynamic_payment_button = false
                  if block.settings.enable_payment_button and product.selling_plan_groups == empty and gift_card_recipient_feature_active == false
                    unless product.template_suffix contains 'preorder'
                      assign enable_dynamic_payment_button = true
                    endunless
                  endif
                -%}

                {% if gift_card_recipient_feature_active %}
                  {% render 'gift-card-recipient', section: section %}
                {% endif %}

                <div class="quantity-submit-row input-row {% if enable_dynamic_payment_button %}has-spb{% endif %}">
                  {% if block.settings.show_quantity_selector %}
                    <label class="label" for="quantity">{{ 'products.product.quantity' | t }}</label>
                    <quantity-wrapper class="buttoned-input">
                      <a href="#" data-quantity="down" aria-label="{{ 'cart.items.decrease_quantity' | t }}">{% render 'icon-minus' %}</a>
                      <input aria-label="{{ 'products.product.quantity' | t }}" id="quantity" type="number" name="quantity" value="1" />
                      <a href="#" data-quantity="up" aria-label="{{ 'cart.items.increase_quantity' | t }}">{% render 'icon-plus' %}</a>
                    </quantity-wrapper>
                  {% endif %}

                  <div class="quantity-submit-row__submit input-row" data-dynamic-variant-content="{{ block.id }}-atc">
                    <div class="js-form-error lightly-spaced-row" role="alert" hidden></div>

                    {%- capture add_to_cart_text -%}
                      {%- if product.template_suffix contains 'preorder' -%}
                        {{- 'products.product.preorder' | t -}}
                      {%- else -%}
                        {{- 'products.product.add_to_cart' | t -}}
                      {%- endif -%}
                    {%- endcapture -%}
                    {%- liquid
                      assign atc_style_desktop = block.settings.button_style_desktop | default: 'style_1'
                      assign atc_style_mobile = block.settings.button_style_mobile | default: 'style_1'
                    -%}
                    <button class="btn btn--large nw-button add-to-cart nw-button--d-{{ atc_style_desktop }} nw-button--m-{{ atc_style_mobile }}" type="submit" name="add" data-add-to-cart-text="{{ add_to_cart_text | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
                      {%- if current_variant.available or current_variant == false -%}
                        {{- add_to_cart_text -}}
                      {%- else -%}
                        {{- 'products.variant.no_stock' | t -}}
                      {%- endif -%}
                    </button>
                    {%- if block.settings.button_footer_text != blank -%}
                      <p class="add-to-cart-footer-text">{{ block.settings.button_footer_text | escape }}</p>
                    {%- endif -%}
                  </div>

                  {% if enable_dynamic_payment_button %}
                    <buy-buttons class="product-dynamic-payment-button">
                      <script class="dynamic-payment-button-template" type="text/template">
                        {{ form | payment_button }}
                      </script>
                    </buy-buttons>
                  {% endif %}

                  {% if block.settings.show_backorder_text %}
                    <div data-dynamic-variant-content="{{ block.id }}-backorder">
                      {%- render 'backorder', product: product, variant: current_variant -%}
                    </div>
                  {% endif %}
                </div>
              {% endform %}

              {%- if block.settings.show_pickup_availability -%}
                <div data-dynamic-variant-content="{{ block.id }}-pickup-availability"{% unless product.available %} hidden{% endunless %}>
                  {% render 'pickup-availability', current_variant: current_variant %}
                </div>
              {%- endif -%}
            </div>
          {% when 'inventory-level' %}
            <div class="fade-in-up not-in-quickbuy" data-dynamic-variant-content="{{ block.id }}"{{- nw_pdp_block_animate -}}>
              {%- render 'product-inventory', product: product, current_variant: current_variant, block: block -%}
            </div>

          {% when 'accordion' %}
            {%- liquid
              assign content = block.settings.content
              if block.settings.page != blank
                assign content = pages[block.settings.page].content
              endif
              assign content = content | append: block.settings.custom_liquid
            -%}
            <div class="product-info-accordion fade-in-up not-in-quickbuy"
                {%- if block.settings.variant_content %} data-dynamic-variant-content="{{ block.id }}"{% endif %}
                {%- if content == blank %} hidden{% endif %}
                {{- nw_pdp_block_animate -}}>
              <details-disclosure>
                <details class="disclosure"{% if block.settings.open %} open{% endif %}>
                  <summary class="disclosure__title">
                    {%- if block.settings.icon == blank -%}
                      {{- block.settings.title | escape -}}
                      <span class="disclosure__icon disclosure__icon--plus">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                      <span class="disclosure__icon disclosure__icon--minus">{{ 'icon-minus.svg' | inline_asset_content }}</span>
                    {%- else -%}
                      <div class="with-icon">
                        {% render 'icon', icon: block.settings.icon, size: 'small' %}
                        <span class="with-icon__beside">{{ block.settings.title | escape }}</span>
                      </div>
                    {%- endif -%}
                  </summary>
                  <div class="disclosure__panel has-motion">
                    <div class="disclosure__content rte cf">
                      {{- content -}}
                    </div>
                  </div>
                </details>
              </details-disclosure>
            </div>

          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="lightly-spaced-row fade-in-up not-in-quickbuy"{{- nw_pdp_block_animate -}}>
                {%- liquid
                  if block.settings.enable_box
                    assign box_color_brightness = block.settings.box_color | color_brightness
                    if box_color_brightness > 128
                      assign box_color_saturation = block.settings.box_color | color_extract: 'saturation'
                      if box_color_saturation > 0
                        assign text_col = block.settings.box_color | color_darken: 60 | color_saturate: 30 | color_to_rgb | split: '(' | last | split: ')' | first
                      else
                        assign text_col = block.settings.box_color | color_darken: 60 | color_to_rgb | split: '(' | last | split: ')' | first
                      endif
                    else
                      assign text_col = '255,255,255'
                    endif
                  endif
                -%}
                <div class="product-info-block{% if block.settings.icon != blank or block.settings.custom_icon != blank %} with-icon{% endif %}{% if block.settings.enable_box %} text-box{% endif %}" {% if block.settings.enable_box %}style="--box-color: {{ block.settings.box_color }}; --box-text-color: {{ text_col }}"{% endif %}>
                  {%- if block.settings.icon == blank and block.settings.custom_icon == blank -%}
                    {{- block.settings.text -}}
                  {%- else -%}
                    {% if block.settings.custom_icon == blank %}
                      {% render 'icon', icon: block.settings.icon, size: block.settings.icon_size %}
                    {% else %}
                      {%- liquid
                        if block.settings.icon_size == 'large'
                          assign icon_sizes = '38px'
                          assign icon_widths = '38, 76'
                        else
                          assign icon_sizes = '16px'
                          assign icon_widths = '16, 32'
                        endif
                      -%}
                      <span class="icon icon--image icon--{{ block.settings.icon_size }}">
                        {%- render 'image' with block.settings.custom_icon, sizes: icon_sizes, widths: icon_widths -%}
                      </span>
                    {% endif %}
                    <span class="with-icon__beside">{{ block.settings.text }}</span>
                  {%- endif -%}
                </div>
              </div>
            {% endif %}

          {% when 'richtext' %}
            {% if block.settings.richtext != blank %}
              <div class="lightly-spaced-row fade-in-up not-in-quickbuy"{{- nw_pdp_block_animate -}}>
                {%- liquid
                  if block.settings.enable_box
                    assign box_color_brightness = block.settings.box_color | color_brightness
                    if box_color_brightness > 128
                      assign box_color_saturation = block.settings.box_color | color_extract: 'saturation'
                      if box_color_saturation > 0
                        assign text_col = block.settings.box_color | color_darken: 60 | color_saturate: 30 | color_to_rgb | split: '(' | last | split: ')' | first
                      else
                        assign text_col = block.settings.box_color | color_darken: 60 | color_to_rgb | split: '(' | last | split: ')' | first
                      endif
                    else
                      assign text_col = '255,255,255'
                    endif
                  endif
                -%}
                <div class="product-info-block{% if block.settings.icon != blank or block.settings.custom_icon != blank %} with-icon{% endif %}{% if block.settings.enable_box %} text-box{% endif %}" {% if block.settings.enable_box %}style="--box-color: {{ block.settings.box_color }}; --box-text-color: {{ text_col }}"{% endif %}>
                  {%- if block.settings.icon == blank and block.settings.custom_icon == blank -%}
                    <div class="rte cf">{{ block.settings.richtext }}</div>
                  {%- else -%}
                    {% if block.settings.custom_icon == blank %}
                      {% render 'icon', icon: block.settings.icon, size: block.settings.icon_size %}
                    {% else %}
                      {%- liquid
                        if block.settings.icon_size == 'large'
                          assign icon_sizes = '38px'
                          assign icon_widths = '38, 76'
                        else
                          assign icon_sizes = '16px'
                          assign icon_widths = '16, 32'
                        endif
                      -%}
                      <span class="icon icon--image icon--{{ block.settings.icon_size }}">
                        {%- render 'image' with block.settings.custom_icon, sizes: icon_sizes, widths: icon_widths -%}
                      </span>
                    {% endif %}
                    <div class="with-icon__beside rte cf">{{ block.settings.richtext }}</div>
                  {%- endif -%}
                </div>
              </div>
            {% endif %}

          {% when 'pop-up' %}
            {% if block.settings.page != blank %}
              <div class="lightly-spaced-row fade-in-up not-in-quickbuy"{{- nw_pdp_block_animate -}}>
                <modal-opener data-modal="modal-{{ block.id }}">
                  <button type="button" class="{% if block.settings.style != 'link' %}btn btn--{{ block.settings.style }}{% else %}small-feature-link{% endif %}" aria-haspopup="dialog">
                    {{- block.settings.text | escape -}}
                  </button>
                </modal-opener>
              </div>
            {% endif %}

          {% when 'link' %}
            {% if block.settings.text != blank %}
              <div class="lightly-spaced-row fade-in-up{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}"{{- nw_pdp_block_animate -}}>
                <a class="{% if block.settings.style != 'link' %}btn btn--{{ block.settings.style }}{% else %}small-feature-link{% endif %}" href="{{ block.settings.url }}"{% if block.settings.open_in_new_tab %} target="_blank"{% endif %}>{{ block.settings.text | escape }}</a>
              </div>
            {% endif %}

          {% when 'image' %}
            {% if block.settings.image != blank %}
              <div class="lightly-spaced-row inline-width-container fade-in-up not-in-quickbuy" style="width: {{ block.settings.image_width }}px"{{- nw_pdp_block_animate -}}>
                {% if block.settings.url != blank %}<a href="{{ block.settings.url }}"{% if block.settings.open_in_new_tab %} target="_blank"{% endif %}>{% endif %}
                  {%- assign image_max_width = block.settings.image_width | at_most: 490 -%}
                  {%- capture image_widths -%}(min-width: {{ image_max_width }}px) {{ image_max_width }}px, 100vw{%- endcapture -%}
                  {%- liquid
                    assign image_widths = '320, 480, 580, 640, 700' | append: image_max_width | append: ', '
                    assign image_widths = image_max_width | times: 2 | append: 'px' | prepend: image_widths
                    render 'image' with block.settings.image, sizes: image_widths, widths: image_widths
                  -%}
                {% if block.settings.url != blank %}</a>{% endif %}
              </div>
            {% endif %}

          {% when 'icon-columns' %}
            {% if block.settings.icon_1 != blank or block.settings.custom_icon_1 != blank or block.settings.icon_2 != blank or block.settings.custom_icon_2 != blank or block.settings.icon_3 != blank or block.settings.custom_icon_3 != blank %}
              {%- liquid
                if block.settings.enable_box
                  assign box_color_brightness = block.settings.box_color | color_brightness
                  if box_color_brightness > 128
                    assign box_color_saturation = block.settings.box_color | color_extract: 'saturation'
                    if box_color_saturation > 0
                      assign text_col = block.settings.box_color | color_darken: 60 | color_saturate: 30 | color_to_rgb | split: '(' | last | split: ')' | first
                    else
                      assign text_col = block.settings.box_color | color_darken: 60 | color_to_rgb | split: '(' | last | split: ')' | first
                    endif
                  else
                    assign text_col = '255,255,255'
                  endif
                endif

                assign icon_count = 0
                if block.settings.icon_1 != blank or block.settings.custom_icon_1 != blank
                  assign icon_count = icon_count | plus: 1
                endif
                if block.settings.icon_2 != blank or block.settings.custom_icon_2 != blank
                  assign icon_count = icon_count | plus: 1
                endif
                if block.settings.icon_3 != blank or block.settings.custom_icon_3 != blank
                  assign icon_count = icon_count | plus: 1
                endif
              -%}
              <div class="fade-in-up not-in-quickbuy{% if block.settings.enable_box %} my-gutter text-box text-box--wide{% else %} my-7{% endif %}"{% if block.settings.enable_box %} style="--box-color: {{ block.settings.box_color }}; --box-text-color: {{ text_col }}"{% endif %}{{- nw_pdp_block_animate -}}>
                <div class="flex gap-gutter align-center
                            {%- if block.settings.enable_box %} my-2 px-2{% endif %}
                            {%- if icon_count == 2 %} mx-5{% endif %}
                            {%- if block.settings.text_size == 'sm' %} text-sm{% endif %}">
                  {% if block.settings.icon_1 != blank or block.settings.custom_icon_1 != blank %}
                    <div class="flex-1">
                      {% if block.settings.custom_icon_1 == blank %}
                        <span{% if block.settings.icon_1_color.alpha > 0 %} style="color: {{ block.settings.icon_1_color }}"{% endif %}>
                          {%- render 'icon', icon: block.settings.icon_1, size: block.settings.icon_size -%}
                        </span>
                      {% else %}
                        {%- liquid
                          if block.settings.icon_size == 'extra-large'
                            assign icon_sizes = '52px'
                            assign icon_widths = '52, 104'
                          elsif block.settings.icon_size == 'large'
                            assign icon_sizes = '38px'
                            assign icon_widths = '38, 76'
                          else
                            assign icon_sizes = '24px'
                            assign icon_widths = '24, 48'
                          endif
                        -%}
                        <div class="icon icon--image icon--{{ block.settings.icon_size }} mx-auto">
                          {%- render 'image' with block.settings.custom_icon_1, sizes: icon_sizes, widths: icon_widths -%}
                        </div>
                      {% endif %}
                      {% if block.settings.icon_1_heading != blank %}
                        <div class="mt-2"><strong role="heading" aria-level="2">{{ block.settings.icon_1_heading }}</strong></div>
                      {% endif %}
                      {% if block.settings.icon_1_text != blank %}
                        <div class="{% if block.settings.icon_1_heading == blank %}mt-2{% endif %}">{{ block.settings.icon_1_text }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.icon_2 != blank or block.settings.custom_icon_2 != blank %}
                    <div class="flex-1">
                      {% if block.settings.custom_icon_2 == blank %}
                        <span{% if block.settings.icon_2_color.alpha > 0 %} style="color: {{ block.settings.icon_2_color }}"{% endif %}>
                          {%- render 'icon', icon: block.settings.icon_2, size: block.settings.icon_size -%}
                        </span>
                      {% else %}
                        {%- liquid
                          if block.settings.icon_size == 'extra-large'
                            assign icon_sizes = '52px'
                            assign icon_widths = '52, 104'
                          elsif block.settings.icon_size == 'large'
                            assign icon_sizes = '38px'
                            assign icon_widths = '38, 76'
                          else
                            assign icon_sizes = '24px'
                            assign icon_widths = '24, 48'
                          endif
                        -%}
                        <div class="icon icon--image icon--{{ block.settings.icon_size }} mx-auto">
                          {%- render 'image' with block.settings.custom_icon_2, sizes: icon_sizes, widths: icon_widths -%}
                        </div>
                      {% endif %}
                      {% if block.settings.icon_2_heading != blank %}
                        <div class="mt-2"><strong role="heading" aria-level="2">{{ block.settings.icon_2_heading }}</strong></div>
                      {% endif %}
                      {% if block.settings.icon_2_text != blank %}
                        <div class="{% if block.settings.icon_2_heading == blank %}mt-2{% endif %}">{{ block.settings.icon_2_text }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.icon_3 != blank or block.settings.custom_icon_3 != blank %}
                    <div class="flex-1">
                      {% if block.settings.custom_icon_3 == blank %}
                        <span{% if block.settings.icon_3_color.alpha > 0 %} style="color: {{ block.settings.icon_3_color }}"{% endif %}>
                          {%- render 'icon', icon: block.settings.icon_3, size: block.settings.icon_size -%}
                        </span>
                      {% else %}
                        {%- liquid
                          if block.settings.icon_size == 'extra-large'
                            assign icon_sizes = '52px'
                            assign icon_widths = '52, 104'
                          elsif block.settings.icon_size == 'large'
                            assign icon_sizes = '38px'
                            assign icon_widths = '38, 76'
                          else
                            assign icon_sizes = '24px'
                            assign icon_widths = '24, 48'
                          endif
                        -%}
                        <div class="icon icon--image icon--{{ block.settings.icon_size }} mx-auto">
                          {%- render 'image' with block.settings.custom_icon_3, sizes: icon_sizes, widths: icon_widths -%}
                        </div>
                      {% endif %}
                      {% if block.settings.icon_3_heading != blank %}
                        <div class="mt-2"><strong role="heading" aria-level="2">{{ block.settings.icon_3_heading }}</strong></div>
                      {% endif %}
                      {% if block.settings.icon_3_text != blank %}
                        <div class="{% if block.settings.icon_3_heading == blank %}mt-2{% endif %}">{{ block.settings.icon_3_text }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}

          {% when 'custom-liquid' %}
            <div class="lightly-spaced-row fade-in-up not-in-quickbuy"
                {%- if block.settings.variant_content %} data-dynamic-variant-content="{{ block.id }}"{% endif %}
                {%- if block.settings.custom_liquid == blank %} hidden{% endif %}
                {{- nw_pdp_block_animate -}}>
              {{- block.settings.custom_liquid -}}
            </div>

          {% when 'sharing' %}
            <div class="input-row not-in-quickbuy sharing-row fade-in-up"{{- nw_pdp_block_animate -}}>
              <div class="social-share flex items-center">
                <p class="social-share__heading">{{ 'general.social.share_heading' | t }}</p>
                {% render 'social-share',
                    share_twitter: block.settings.show_twitter,
                    share_facebook: block.settings.show_facebook,
                    share_pinterest: block.settings.show_pinterest,
                    share_title: product.title,
                    share_url: product.url,
                    share_image: product %}
              </div>
            </div>

          {% when 'divider' %}
            <hr class="fade-in-up not-in-quickbuy divider-row"{{- nw_pdp_block_animate -}}>

          {% when 'custom-option' %}
            {%- if block.settings.label != blank -%}
              {%- liquid
                assign custom_option_input_id = product_form_id | append: '-custom-' | append: forloop.index
                assign custom_input_name = block.settings.label | escape | prepend: 'properties[' | append: ']'
              -%}
              <div class="custom-option fade-in-up"{{- nw_pdp_block_animate -}}>
                {% case block.settings.type %}
                  {% when 'text' %}
                    <div class="option-selector option-selector--custom">
                      <label class="label" for="{{ custom_option_input_id }}">{{ block.settings.label | escape }}</label>
                      <input class="custom-option__text-input" type="text" id="{{ custom_option_input_id }}" form="{{ product_form_id }}" name="{{ custom_input_name }}" {% if block.settings.text_required %}required{% endif %}>
                    </div>

                  {% when 'textarea' %}
                    <div class="option-selector option-selector--custom">
                      <label class="label" for="{{ custom_option_input_id }}">{{ block.settings.label | escape }}</label>
                      <textarea class="custom-option__text-input" id="{{ custom_option_input_id }}" form="{{ product_form_id }}" name="{{ custom_input_name }}" {% if block.settings.text_required %}required{% endif %}></textarea>
                    </div>

                  {% when 'checkbox' %}
                    <div class="option-selector option-selector--custom">
                      <label class="label">
                        <input type="hidden" form="{{ product_form_id }}" name="{{ custom_input_name }}" value="{{ block.settings.checkbox_unchecked_value | escape }}">
                        <input type="checkbox" form="{{ product_form_id }}" name="{{ custom_input_name }}" value="{{ block.settings.checkbox_checked_value | escape }}">
                        <span class="label__text-beside-input">{{ block.settings.label | escape }}</span>
                      </label>
                    </div>

                  {% when 'multiple' %}
                    {%- assign custom_options = block.settings.multiple_options | newline_to_br | strip_newlines | split: '<br />' -%}

                    {% if block.settings.multiple_style == 'dropdown' %}
                      <div class="option-selector option-selector--custom" data-selector-type="dropdown">
                        <script src="{{ 'custom-select.js' | asset_url }}" defer></script>
                        {% render 'custom-select',
                          id: custom_option_input_id,
                          label: block.settings.label,
                          option_values: custom_options,
                          selected_value: custom_options.first,
                          include_native: true,
                          native_name: custom_input_name,
                          native_form_id: product_form_id
                        %}
                      </div>

                    {% else %}
                      <div class="option-selector option-selector--custom" data-selector-type="radio">
                        <fieldset>
                          <legend class="label">{{ block.settings.label | escape }}</legend>
                          {% for option in custom_options %}
                            <label class="label">
                              <input type="radio" form="{{ product_form_id }}" name="{{ custom_input_name }}" value="{{ option | escape }}"{% if forloop.first %} checked{% endif %}>
                              <span class="label__text-beside-input">{{ option | escape }}</span>
                            </label>
                          {% endfor %}
                        </fieldset>
                      </div>
                    {% endif %}

                {% endcase %}
              </div>
            {%- endif -%}

          {% when 'related-products' %}
            <div class="{% if block.settings.style == 'card' %}lightly-spaced-row lightish-spaced-row-above{% else %}input-row related-products-row{% endif %}
                        fade-in-up not-in-quickbuy"
                 data-dynamic-product-content="{{ block.id }}"
                 {% if block.settings.product_list == blank %} hidden{% endif %}
                 {{- nw_pdp_block_animate -}}>
              <div class="label" role="heading" aria-level="2">{{ block.settings.title | escape }}</div>
              {%- liquid
                if block.settings.style == 'card' or block.settings.style == 'image'
                  if settings.prod_thumb_shape == 'portrait-23'
                    assign chosen_aspect_ratio = 0.67
                  elsif settings.prod_thumb_shape == 'portrait-45'
                    assign chosen_aspect_ratio = 0.8
                  elsif settings.prod_thumb_shape == 'square'
                    assign chosen_aspect_ratio = 1.0
                  elsif settings.prod_thumb_shape == 'landscape-54'
                    assign chosen_aspect_ratio = 1.25
                  elsif settings.prod_thumb_shape == 'landscape-32'
                    assign chosen_aspect_ratio = 1.50
                  elsif settings.prod_thumb_shape == 'tallest'
                    assign chosen_aspect_ratio = 99
                    for related_product in block.settings.product_list
                      if related_product.featured_media.preview_image.aspect_ratio < chosen_aspect_ratio
                        assign chosen_aspect_ratio = related_product.featured_media.preview_image.aspect_ratio
                      endif
                    endfor
                  else
                    assign chosen_aspect_ratio = 0
                    for related_product in block.settings.product_list
                      if related_product.featured_media.preview_image.aspect_ratio > chosen_aspect_ratio
                        assign chosen_aspect_ratio = related_product.featured_media.preview_image.aspect_ratio
                      endif
                    endfor
                  endif

                  if settings.prod_thumb_crop
                    assign custom_crop = settings.prod_thumb_crop_align
                  else
                    assign custom_crop = 'contain'
                  endif

                  if block.settings.style == 'image' and block.settings.image_circle
                    assign chosen_aspect_ratio = 1.0
                    assign custom_crop = block.settings.image_crop_align
                  endif
                endif
              -%}
              {%- if block.settings.style == 'card' -%}
                <div class="fixed-layout">
                  {%- for related_product in block.settings.product_list -%}
                    <div class="column column--half">
                      {%- render 'product-block', product: related_product, no_quick_buy: true, custom_aspect_ratio: chosen_aspect_ratio, grid: 5 -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- elsif block.settings.style == 'image' -%}
                <div class="related-swatches" style="--image-width: {{ block.settings.image_width }}px">
                  {%- capture widths -%}{{ block.settings.image_width }}, {{ block.settings.image_width | times: 2 }}{%- endcapture -%}
                  {%- for related_product in block.settings.product_list -%}
                    <a class="related-swatch
                        {%- if related_product.metafields.theme.product_color != blank %} related-swatch--swatch{% else %} img-var{% endif %}
                        {%- if block.settings.image_circle %} related-swatch--circle{% endif %}
                        {%- if related_product.id == product.id %} related-swatch--active{% endif %}
                        {%- unless related_product.available %} related-swatch--unavailable{% endunless %}"
                      {%- if related_product.metafields.theme.product_color != blank %} style="--swatch-background-color: {{ related_product.metafields.theme.product_color }}"{% endif -%}
                      href="{% if collection and related_product.collections contains collection %}{{ related_product.url | within: collection }}{% else %}{{ related_product.url }}{% endif %}"
                      title="{{ related_product.title | escape }}">
                      {%- if related_product.metafields.theme.product_color == blank -%}
                        {%- render 'image',
                          image: related_product.featured_media.preview_image,
                          sizes: block.settings.image_width,
                          widths: widths,
                          custom_aspect_ratio: chosen_aspect_ratio,
                          custom_crop: custom_crop
                        -%}
                      {%- endif -%}
                      <span class="visually-hidden">{{ related_product.title | escape }}</span>
                    </a>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="related-swatches">
                  {%- for related_product in block.settings.product_list -%}
                    <a class="opt-label btn
                        {%- if related_product.id == product.id %} opt-label--active{% endif %}
                        {%- unless related_product.available %} opt-label--is-unavailable{% endunless %}"
                      href="{% if collection and related_product.collections contains collection %}{{ related_product.url | within: collection }}{% else %}{{ related_product.url }}{% endif %}">
                      {{- related_product.title | escape -}}
                    </a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

          {% when 'complementary' %}
            <cc-fetched-content class="not-in-quickbuy fade-in-up"
                                data-id="{{ block.id }}"
                                data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&intent=complementary"
                                contains-product-blocks
                                data-dynamic-product-content="{{ block.id }}"
                                {{- nw_pdp_block_animate -}}>
              {%- if recommendations.performed and recommendations.products_count > 0 -%}
                {%- liquid
                  if settings.prod_thumb_shape == 'portrait-23'
                    assign chosen_aspect_ratio = 0.67
                  elsif settings.prod_thumb_shape == 'portrait-45'
                    assign chosen_aspect_ratio = 0.8
                  elsif settings.prod_thumb_shape == 'square'
                    assign chosen_aspect_ratio = 1.0
                  elsif settings.prod_thumb_shape == 'landscape-54'
                    assign chosen_aspect_ratio = 1.25
                  elsif settings.prod_thumb_shape == 'landscape-32'
                    assign chosen_aspect_ratio = 1.50
                  elsif settings.prod_thumb_shape == 'tallest'
                    assign chosen_aspect_ratio = 99
                    for product in recommendations.products limit: block.settings.max_products
                      if product.featured_media.preview_image.aspect_ratio < chosen_aspect_ratio
                        assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                      endif
                    endfor
                  else
                    assign chosen_aspect_ratio = 0
                    for product in recommendations.products limit: block.settings.max_products
                      if product.featured_media.preview_image.aspect_ratio > chosen_aspect_ratio
                        assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                      endif
                    endfor
                  endif
                -%}

                <div class="lightly-spaced-row lightish-spaced-row-above not-in-quickbuy">
                  {% if block.settings.enable_carousel and recommendations.products_count > 2 and block.settings.max_products > 2 %}
                    <carousel-slider class="carousel block collection-slider">
                      <div class="opposing-items opposing-items--valign-base very-lightly-spaced-row">
                        <div class="opposing-items__left label">{{ block.settings.heading | escape }}</div>
                        <div class="no-wrap slider-nav">
                          <button name="prev" class="slider-nav__btn has-ltr-icon text-current">
                            <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                            {% render 'icon-chevron-left' %}
                          </button>
                          <button name="next" class="slider-nav__btn has-ltr-icon text-current">
                            <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                            {% render 'icon-chevron-right' %}
                          </button>
                        </div>
                      </div>
                      <div class="collection-listing slider slider--no-scrollbar">
                        <div class="product-grid product-grid--per-row-2 product-grid--per-row-mob-2 slider__grid product-grid--carousel">
                          {% for related_product in recommendations.products limit: block.settings.max_products %}
                            <div class="slider__item{% if forloop.first %} is-active{% endif %}">
                              {%- render 'product-block', product: related_product, no_quick_buy: true, no_swiping: true, custom_aspect_ratio: chosen_aspect_ratio, grid: 5 -%}
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    </carousel-slider>
                  {% else %}
                    <div class="very-lightly-spaced-row">
                      <div class="label">{{ block.settings.heading | escape }}</div>
                    </div>
                    <div class="fixed-layout fixed-layout--no-wide-gutter">
                      {%- liquid
                        for related_product in recommendations.products limit: block.settings.max_products
                          echo '<div class="column column--half">'
                          render 'product-block', product: related_product, no_quick_buy: true, custom_aspect_ratio: chosen_aspect_ratio, grid: 5
                          echo '</div>'
                        endfor
                      -%}
                    </div>
                  {% endif %}
                </div>
              {%- endif -%}
            </cc-fetched-content>

          {% when 'countdown' %}
            <div class="lightly-spaced-row fade-in-up not-in-quickbuy"{{- nw_pdp_block_animate -}}>
              {%- liquid
                assign hide_on_end = block.settings.hide_on_end | default: false
                assign now = "now" | date: '%Y-%m-%dT%H:%M%z'
                if block.settings.end_date != blank
                  if block.settings.end_time != blank
                    assign end_date = block.settings.end_date | append: 'T' | append: block.settings.end_time
                  endif
                  assign end_date = end_date | date: '%Y-%m-%dT%H:%M%z'
                else
                  assign now_split = now | split: "T"
                  assign end_date = now_split.first | append: "T23:59%z" | date: '%Y-%m-%dT%H:%M%z'
                endif
              -%}
              {%- if end_date > now or hide_on_end == false -%}
                <script src="{{ 'countdown-timer.js' | asset_url }}" defer></script>
                <div class="product-info-block text-box text-box--wide align-center countdown-font-{{ block.settings.number_font }} countdown-divider-{{ block.settings.divider_type }}" style="--box-color: {{ block.settings.box_color }}; --box-text-color: {{ block.settings.text_color | color_to_rgb | split: '(' | last | split: ')' | first }}">
                  {%- if block.settings.heading != blank -%}
                    <div class="very-lightly-spaced-row">{{ block.settings.heading }}</div>
                  {%- endif -%}
                  {% render 'countdown-timer',
                    end_date: block.settings.end_date,
                    end_time: block.settings.end_time,
                    end_text: block.settings.end_text,
                    end_midnight: true,
                    hide_on_end: block.settings.hide_on_end,
                    show_labels: block.settings.show_timer_labels
                  %}
                </div>
              {%- endif -%}
            </div>

          {% when 'feature-rating' %}
            <link rel="stylesheet" href="{{ 'feature-rating.css' | asset_url }}">
            <div class="input-row feature-rating-row fade-in-up not-in-quickbuy"{{- nw_pdp_block_animate -}}>
              {%- if block.settings.heading != blank -%}
                <div class="lightly-spaced-row"><strong role="heading" aria-level="2">{{ block.settings.heading }}</strong></div>
              {%- endif -%}

              {% render 'feature-rating',
                segments: block.settings.segments,
                active_segment: block.settings.active_segment,
                fill_segments: block.settings.fill_segments,
                show_labels: block.settings.show_labels,
                label_left: block.settings.label_left,
                label_middle: block.settings.label_middle,
                label_right: block.settings.label_right
              %}
            </div>

          {% when 'nw-size-links', 'nw-gender-links' %}
            <div class="nw-product-size-links variant-picker-row fade-in-up not-in-quickbuy" data-active-size="{{ nw_pdp_active_size }}" data-dynamic-product-content="nw-size-links-{{ block.id }}"{{- nw_pdp_block_animate -}}>
              {%- liquid
                assign womens_url = ''
                assign mens_url = ''
                if block.settings.womens_product != blank
                  assign womens_url = block.settings.womens_product.url
                endif
                if block.settings.mens_product != blank
                  assign mens_url = block.settings.mens_product.url
                endif

                assign women_active = false
                assign men_active = false
                if nw_pdp_active_size == 'men'
                  assign men_active = true
                else
                  assign women_active = true
                endif

                assign nw_size_links_info_target = blank
                assign nw_size_links_info_label = block.settings.size_chart_label | default: 'Size guide'
                assign nw_size_links_show_info = false

                if block.settings.enable_size_chart
                  if block.settings.size_chart_source == 'section' or block.settings.size_chart_page != blank
                    assign nw_size_chart_variant_names = block.settings.size_chart_variant | split: ',' | compact
                    for option in product.options_with_values
                      assign option_name_dcase = option.name | downcase
                      for name in nw_size_chart_variant_names
                        assign setting_name_sanitized = name | strip | downcase
                        if option_name_dcase == setting_name_sanitized
                          assign nw_size_links_show_info = true
                          break
                        endif
                      endfor
                      if nw_size_links_show_info
                        break
                      endif
                    endfor
                    if nw_size_links_show_info
                      assign nw_size_links_info_target = 'size-chart-' | append: product.id
                    endif
                  endif
                endif

                if nw_size_links_info_target == blank and block.settings.popup_trigger_id != blank and block.settings.popup_trigger_id != '#'
                  assign nw_size_links_info_target = block.settings.popup_trigger_id
                  assign nw_size_links_show_info = true
                  assign nw_size_links_info_label = 'Size guide'
                endif
              -%}
              <div class="nw-product-size-links__row">
                <div class="nw-product-size-links__links">
                  {%- if block.settings.womens_label != blank -%}
                    {%- if women_active -%}
                      <span class="nw-product-size-links__link is-active" aria-current="true">{{ block.settings.womens_label | escape }}</span>
                    {%- elsif womens_url != blank -%}
                      <a class="nw-product-size-links__link" href="{{ womens_url }}" data-nw-size-target="women">{{ block.settings.womens_label | escape }}</a>
                    {%- else -%}
                      <span class="nw-product-size-links__link">{{ block.settings.womens_label | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.mens_label != blank -%}
                    {%- if men_active -%}
                      <span class="nw-product-size-links__link is-active" aria-current="true">{{ block.settings.mens_label | escape }}</span>
                    {%- elsif mens_url != blank -%}
                      <a class="nw-product-size-links__link" href="{{ mens_url }}" data-nw-size-target="men">{{ block.settings.mens_label | escape }}</a>
                    {%- else -%}
                      <span class="nw-product-size-links__link">{{ block.settings.mens_label | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if nw_size_links_show_info and nw_size_links_info_target != blank -%}
                  <script src="{{ 'open-or-scroll-to.js' | asset_url }}" defer></script>
                  {%- unless nw_size_links_info_target contains 'size-chart-' -%}
                    {{ 'nw-popup.css' | asset_url | stylesheet_tag }}
                  {%- endunless -%}
                  <open-or-scroll-to data-target-id="{{ nw_size_links_info_target | escape }}">
                    <button
                      type="button"
                      class="nw-product-size-links__info-btn"
                      aria-label="{{ nw_size_links_info_label | escape }}">
                      <span class="nw-product-size-links__info-icon" aria-hidden="true">{{ 'info-icon.svg' | inline_asset_content }}</span>
                    </button>
                  </open-or-scroll-to>
                {%- endif -%}
              </div>
            </div>

          {% when 'nw-thickness' %}
            {%- liquid
              assign nw_active_womens_url = ''
              assign nw_active_mens_url = ''
              for i in (1..5)
                case i
                  when 1
                    assign nw_th_option_womens = block.settings.option_1_womens_product
                    assign nw_th_option_mens = block.settings.option_1_mens_product
                  when 2
                    assign nw_th_option_womens = block.settings.option_2_womens_product
                    assign nw_th_option_mens = block.settings.option_2_mens_product
                  when 3
                    assign nw_th_option_womens = block.settings.option_3_womens_product
                    assign nw_th_option_mens = block.settings.option_3_mens_product
                  when 4
                    assign nw_th_option_womens = block.settings.option_4_womens_product
                    assign nw_th_option_mens = block.settings.option_4_mens_product
                  when 5
                    assign nw_th_option_womens = block.settings.option_5_womens_product
                    assign nw_th_option_mens = block.settings.option_5_mens_product
                endcase
                if nw_th_option_womens != blank and product.id == nw_th_option_womens.id
                  assign nw_active_womens_url = nw_th_option_womens.url
                  if nw_th_option_mens != blank
                    assign nw_active_mens_url = nw_th_option_mens.url
                  endif
                  break
                endif
                if nw_th_option_mens != blank and product.id == nw_th_option_mens.id
                  if nw_th_option_womens != blank
                    assign nw_active_womens_url = nw_th_option_womens.url
                  endif
                  assign nw_active_mens_url = nw_th_option_mens.url
                  break
                endif
              endfor
            -%}
            <nw-thickness-picker
              class="nw-product-thickness variant-picker-row fade-in-up not-in-quickbuy"
              data-size-context="{{ nw_pdp_active_size }}"
              data-active-womens-url="{{ nw_active_womens_url }}"
              data-active-mens-url="{{ nw_active_mens_url }}"
              data-dynamic-product-content="nw-thickness-{{ block.id }}"
              {{- nw_pdp_block_animate -}}>
              <div class="nw-product-thickness__header">
                {%- if block.settings.heading != blank -%}
                  <span class="label">{{ block.settings.heading | escape }}</span>
                  {%- if block.settings.popup_trigger_id != blank -%}
                    <script src="{{ 'open-or-scroll-to.js' | asset_url }}" defer></script>
                    {{ 'nw-popup.css' | asset_url | stylesheet_tag }}
                    <open-or-scroll-to data-target-id="{{ block.settings.popup_trigger_id | escape }}">
                      <button
                        type="button"
                        class="nw-product-thickness__info-btn"
                        aria-label="{{ 'Thickness information' | escape }}">
                        <span class="label-icon" aria-hidden="true">{{ 'info-icon.svg' | inline_asset_content }}</span>
                      </button>
                    </open-or-scroll-to>
                  {%- else -%}
                    <span class="label-icon" aria-hidden="true">{{ 'info-icon.svg' | inline_asset_content }}</span>
                  {%- endif -%}
                {%- endif -%}
              </div>
              <div class="nw-product-thickness__description">
                {%- if block.settings.description != blank -%}
                  <div class="rte">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>
              {% if block.settings.option_1_label != blank or block.settings.option_2_label != blank or block.settings.option_3_label != blank or block.settings.option_4_label != blank or block.settings.option_5_label != blank %}
              <div class="nw-product-thickness__options option-selector__btns" role="group" aria-label="{{ block.settings.heading | default: 'Thickness' | escape }}">
                {%- for i in (1..5) -%}
                  {%- liquid
                    case i
                      when 1
                        assign option_label = block.settings.option_1_label
                        assign option_womens_product = block.settings.option_1_womens_product
                        assign option_mens_product = block.settings.option_1_mens_product
                      when 2
                        assign option_label = block.settings.option_2_label
                        assign option_womens_product = block.settings.option_2_womens_product
                        assign option_mens_product = block.settings.option_2_mens_product
                      when 3
                        assign option_label = block.settings.option_3_label
                        assign option_womens_product = block.settings.option_3_womens_product
                        assign option_mens_product = block.settings.option_3_mens_product
                      when 4
                        assign option_label = block.settings.option_4_label
                        assign option_womens_product = block.settings.option_4_womens_product
                        assign option_mens_product = block.settings.option_4_mens_product
                      when 5
                        assign option_label = block.settings.option_5_label
                        assign option_womens_product = block.settings.option_5_womens_product
                        assign option_mens_product = block.settings.option_5_mens_product
                    endcase

                    assign option_womens_url = ''
                    assign option_mens_url = ''
                    if option_womens_product != blank
                      assign option_womens_url = option_womens_product.url
                    endif
                    if option_mens_product != blank
                      assign option_mens_url = option_mens_product.url
                    endif

                    assign option_active = false
                    if option_womens_product != blank and product.id == option_womens_product.id
                      assign option_active = true
                    elsif option_mens_product != blank and product.id == option_mens_product.id
                      assign option_active = true
                    endif

                    if nw_pdp_active_size == 'men'
                      assign option_target_url = option_mens_url
                    else
                      assign option_target_url = option_womens_url
                    endif
                  -%}
                  {%- if option_label != blank -%}
                    {%- if option_active -%}
                      <span class="nw-product-thickness__option opt-label is-active" aria-current="true">{{ option_label | escape }}</span>
                    {%- elsif option_target_url != blank -%}
                      <button
                        type="button"
                        class="nw-product-thickness__option opt-label"
                        data-thickness-value="{{ option_label | escape }}"
                        data-womens-url="{{ option_womens_url }}"
                        data-mens-url="{{ option_mens_url }}">
                        {{ option_label | escape }}
                      </button>
                    {%- else -%}
                      <span class="nw-product-thickness__option opt-label is-unavailable">{{ option_label | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {% endif %}
            </nw-thickness-picker>

          {% when 'nw-bundle-save' %}
            <div class="nw-product-bundle-save fade-in-up not-in-quickbuy"{{- nw_pdp_block_animate -}}>
              {%- if block.settings.heading != blank -%}
                <h2 class="nw-product-bundle-save__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="nw-product-bundle-save__subheading">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}
              <div class="nw-product-bundle-save__grid">
                {%- for i in (1..6) -%}
                  {%- liquid
                    case i
                      when 1
                        assign bundle_title = block.settings.item_1_title
                        assign bundle_price = block.settings.item_1_price
                        assign bundle_discount = block.settings.item_1_discount
                      when 2
                        assign bundle_title = block.settings.item_2_title
                        assign bundle_price = block.settings.item_2_price
                        assign bundle_discount = block.settings.item_2_discount
                      when 3
                        assign bundle_title = block.settings.item_3_title
                        assign bundle_price = block.settings.item_3_price
                        assign bundle_discount = block.settings.item_3_discount
                      when 4
                        assign bundle_title = block.settings.item_4_title
                        assign bundle_price = block.settings.item_4_price
                        assign bundle_discount = block.settings.item_4_discount
                      when 5
                        assign bundle_title = block.settings.item_5_title
                        assign bundle_price = block.settings.item_5_price
                        assign bundle_discount = block.settings.item_5_discount
                      when 6
                        assign bundle_title = block.settings.item_6_title
                        assign bundle_price = block.settings.item_6_price
                        assign bundle_discount = block.settings.item_6_discount
                    endcase
                  -%}
                  {%- if bundle_title != blank or bundle_price != blank -%}
                    <div class="nw-product-bundle-save__item">
                      <div class="nw-product-bundle-save__circle">
                        {%- if bundle_discount != blank -%}
                          <span class="nw-product-bundle-save__badge">{{ bundle_discount | escape }}</span>
                        {%- endif -%}
                        {%- if bundle_title != blank -%}
                          <span class="nw-product-bundle-save__item-title">{{ bundle_title | escape }}</span>
                        {%- endif -%}
                        {%- if bundle_price != blank -%}
                          <span class="nw-product-bundle-save__item-price">{{ bundle_price | escape }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.footer_note != blank -%}
                <p class="nw-product-bundle-save__note">{{ block.settings.footer_note | escape }}</p>
              {%- endif -%}
            </div>

        {% endcase %}
      {% endfor %}

      <div class="lightish-spaced-row-above only-in-quickbuy">
        <a class="more" href="{{ product.url }}">
          <span class="beside-svg underline">{{ 'products.product.view_details' | t }}</span>
          <span class="icon--small icon-natcol has-ltr-icon">{% render 'icon-chevron-right' %}</span>
        </a>
      </div>
    </div>

    {%- if section.settings.enable_sticky_columns -%}
      </sticky-scroll>
    {%- endif -%}
  </div>

  {%- render 'product-popups', product: product, current_variant: current_variant -%}
  {%- render 'structured-data-product', product: product, current_variant: product.selected_or_first_available_variant -%}
</product-form>

{%- if section.settings.show_location_underneath -%}
  <div class="product-description rte container cf padded-row not-in-quickbuy">{{ product.description }}</div>
{%- endif -%}

{%- if section.settings.enable_sticky_atc -%}
  {%- render 'sticky-atc', product: product, current_variant: current_variant -%}
{%- endif -%}

