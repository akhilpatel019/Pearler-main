{{ 'nw-section-header.css' | asset_url | stylesheet_tag }}
{{ 'nw-testimonial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign focal_point = 'center center'
  if section.settings.image != blank and section.settings.image.presentation.focal_point
    assign focal_point = section.settings.image.presentation.focal_point
  endif

  assign section_background = 'transparent'
  assign show_media = false

  case section.settings.background_type
    when 'image'
      assign section_background = section.settings.background_color
      assign show_media = true
    when 'solid'
      assign section_background = section.settings.background_color
    when 'linear_gradient'
      assign section_background = section.settings.background_gradient
    when 'none'
      assign section_background = 'transparent'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .nw-testimonial {
    --nw-testimonial-min-height: {{ section.settings.min_height_desktop }}px;
    --nw-testimonial-bg-fallback: {{ section.settings.background_color }};
    --nw-testimonial-background: {{ section_background }};
    --nw-testimonial-focal-point: {{ focal_point }};
    --nw-testimonial-padding-top: {{ section.settings.padding_top_desktop }}px;
    --nw-testimonial-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --nw-testimonial-text-color: {{ section.settings.text_color }};
    --nw-section-header-color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .nw-testimonial {
      --nw-testimonial-min-height: {{ section.settings.min_height_mobile }}px;
      --nw-testimonial-padding-top: {{ section.settings.padding_top_mobile }}px;
      --nw-testimonial-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section
  class="nw-testimonial"
  data-nw-testimonial
  data-transition-duration="{{ section.settings.transition_duration }}"
  data-autoplay="{% if section.settings.enable_autoplay %}true{% else %}false{% endif %}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
  data-enable-loop="{% if section.settings.enable_loop %}true{% else %}false{% endif %}"
>
  {%- if show_media -%}
    <div
      class="nw-testimonial__media-bg fade-in-up"
      aria-hidden="true"
      {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.1s"' -%}
    >
      {%- liquid
        assign section_image = section.settings.image
        assign section_image_mobile = section.settings.mobile_image
      -%}
      {%- if section_image == blank -%}
        <div class="nw-testimonial__media-bg-image nw-testimonial__media-bg-image--placeholder">
          {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' -}}
        </div>
      {%- else -%}
        <img
          src="{{ section_image | image_url: width: 2560 }}"
          alt=""
          class="nw-testimonial__media-bg-image nw-testimonial__media-bg-image--desktop"
          loading="{{ loading }}"
          width="{{ section_image.width }}"
          height="{{ section_image.height }}"
        >
        {%- if section_image_mobile != blank -%}
          <img
            src="{{ section_image_mobile | image_url: width: 1500 }}"
            alt=""
            class="nw-testimonial__media-bg-image nw-testimonial__media-bg-image--mobile"
            loading="{{ loading }}"
            width="{{ section_image_mobile.width }}"
            height="{{ section_image_mobile.height }}"
          >
        {%- else -%}
          <img
            src="{{ section_image | image_url: width: 1500 }}"
            alt=""
            class="nw-testimonial__media-bg-image nw-testimonial__media-bg-image--mobile"
            loading="{{ loading }}"
            width="{{ section_image.width }}"
            height="{{ section_image.height }}"
          >
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="container">
    <div class="nw-testimonial__content">
      <div class="nw-testimonial__inner">
      {%- if section.settings.heading != blank -%}
        <div
          class="nw-section-header fade-in-up"
          {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.15s"' -%}
        >
          <div class="nw-section-header__eyebrow">{{ section.settings.heading }}</div>
        </div>
      {%- endif -%}

      <div
        class="nw-testimonial__stage fade-in-up"
        {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"' -%}
      >
        <button
          type="button"
          class="nw-testimonial__arrow nw-testimonial__arrow--prev"
          data-nw-testimonial-prev
          aria-label="{{ 'general.slider.previous' | t }}"
        >
          
         {{  'right-arrow.svg' | inline_asset_content }}
        </button>

        <div class="swiper nw-testimonial__slider" data-nw-testimonial-slider>
          <div class="swiper-wrapper">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <div class="nw-testimonial__slide-inner">
                    {%- if block.settings.quote != blank -%}
                      <blockquote class="nw-testimonial__quote rte">
                        {{- block.settings.quote -}}
                      </blockquote>
                    {%- endif -%}
                    {%- if block.settings.author != blank or block.settings.author_detail != blank -%}
                      <div class="nw-testimonial__author">
                        {%- if block.settings.author != blank -%}
                          <p class="nw-testimonial__name">{{ block.settings.author | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.author_detail != blank -%}
                          <p class="nw-testimonial__detail">{{ block.settings.author_detail | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="swiper-slide">
                <div class="nw-testimonial__slide-inner">
                  <blockquote class="nw-testimonial__quote rte">
                    <p>“I went straight from an early morning workout to an 8 hour shift, and hadn't thought about my feet once.”</p>
                  </blockquote>
                  <div class="nw-testimonial__author">
                    <p class="nw-testimonial__name">Jake S.</p>
                    <p class="nw-testimonial__detail">(Midlength / core)</p>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        <button
          type="button"
          class="nw-testimonial__arrow nw-testimonial__arrow--next"
          data-nw-testimonial-next
          aria-label="{{ 'general.slider.next' | t }}"
        >
         {{  'left-arrow.svg' | inline_asset_content }}
        </button>
      </div>

      <hr
        class="nw-testimonial__rule-bottom fade-in-up"
        aria-hidden="true"
        {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.45s"' -%}
      >
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NW Testimonial",
  "class": "shopify-section--nw-testimonial",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Eyebrow",
      "default": "what they're saying"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#04022B"
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Slide transition duration",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Enable loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay interval",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "default": 5000,
      "visible_if": "{{ section.settings.enable_autoplay }}"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "default": "solid",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "linear_gradient",
          "label": "Linear gradient"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EBE9E2",
      "visible_if": "{{ section.settings.background_type == 'image' or section.settings.background_type == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(180deg, rgba(235, 233, 226, 1), rgba(255, 255, 255, 1) 100%)",
      "visible_if": "{{ section.settings.background_type == 'linear_gradient' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height desktop",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height mobile",
      "min": 0,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>“I went straight from an early morning workout to an 8 hour shift, and hadn't thought about my feet once.”</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Jake S."
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "Author detail",
          "default": "(Midlength / core)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Testimonial",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>“I went straight from an early morning workout to an 8 hour shift, and hadn't thought about my feet once.”</p>",
            "author": "Jake S.",
            "author_detail": "(Midlength / core)"
          }
        }
      ]
    }
  ]
}
{% endschema %}
