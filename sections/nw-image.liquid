{{ 'nw-image.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-image.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign focal_point = 'center center'
  if section.settings.image != blank and section.settings.image.presentation.focal_point
    assign focal_point = section.settings.image.presentation.focal_point
  endif

  assign section_background = 'transparent'
  assign show_media = false

  case section.settings.background_type
    when 'image'
      assign section_background = section.settings.background_color
      assign show_media = true
    when 'solid'
      assign section_background = section.settings.background_color
    when 'linear_gradient'
      assign section_background = section.settings.background_gradient
    when 'none'
      assign section_background = 'transparent'
  endcase

  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif

  assign section_animate_always = false
  if section.index == 1
    assign section_animate_always = true
  endif

  assign media_bg_anim_attrs = 'data-cc-animate data-cc-animate-delay="0.1s"'
-%}

{% style %}
  #shopify-section-{{ section.id }} .nw-image {
    --nw-image-min-height: {{ section.settings.min_height_desktop }}px;
    --nw-image-bg-fallback: {{ section.settings.background_color }};
    --nw-image-background: {{ section_background }};
    --nw-image-focal-point: {{ focal_point }};
    --nw-image-padding-top: {{ section.settings.padding_top_desktop }}px;
    --nw-image-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .nw-image {
      --nw-image-min-height: {{ section.settings.min_height_mobile }}px;
      --nw-image-padding-top: {{ section.settings.padding_top_mobile }}px;
      --nw-image-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="nw-image">
  {%- if show_media -%}
    <div
      class="nw-image__media-bg fade-in-up"
      aria-hidden="true"
      {%- render 'animation-attrs', attrs: media_bg_anim_attrs, always: section_animate_always -%}
    >
      {%- liquid
        assign section_image = section.settings.image
        assign section_image_mobile = section.settings.mobile_image
      -%}
      {%- if section_image == blank -%}
        <div class="nw-image__media-bg-image nw-image__media-bg-image--placeholder">
          {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' -}}
        </div>
      {%- else -%}
        <img
          src="{{ section_image | image_url: width: 2560 }}"
          alt=""
          class="nw-image__media-bg-image nw-image__media-bg-image--desktop"
          loading="{{ loading }}"
          width="{{ section_image.width }}"
          height="{{ section_image.height }}"
        >
        {%- if section_image_mobile != blank -%}
          <img
            src="{{ section_image_mobile | image_url: width: 1500 }}"
            alt=""
            class="nw-image__media-bg-image nw-image__media-bg-image--mobile"
            loading="{{ loading }}"
            width="{{ section_image_mobile.width }}"
            height="{{ section_image_mobile.height }}"
          >
        {%- else -%}
          <img
            src="{{ section_image | image_url: width: 1500 }}"
            alt=""
            class="nw-image__media-bg-image nw-image__media-bg-image--mobile"
            loading="{{ loading }}"
            width="{{ section_image.width }}"
            height="{{ section_image.height }}"
          >
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="nw-image__content">
    <div class="nw-image__inner">
      {%- if section.settings.seo != blank -%}
        <div
          class="nw-seo "
        >
          <h1>{{- section.settings.seo  -}}</h1>
        </div>
      {%- endif -%}
      <div class="nw-image__grid">
        {%- if has_blocks -%}
          {%- for block in section.blocks -%}
            {%- assign card_delay = forloop.index0 | times: 0.08 | plus: 0.1 -%}
            {%- assign grid_anim_attrs = 'data-cc-animate data-cc-animate-delay="' | append: card_delay | append: 's"' -%}
            <div
              class="nw-image__grid-item fade-in-up"
              style="--nw-image-anim-delay: {{ card_delay }}s;"
              {%- render 'animation-attrs', attrs: grid_anim_attrs, always: section_animate_always -%}
            >
              {%- render 'nw-image-item',
                block: block,
                loading: loading,
                animate_figure: false
              -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..2) -%}
            {%- assign card_delay = i | minus: 1 | times: 0.08 | plus: 0.1 -%}
            {%- assign grid_anim_attrs = 'data-cc-animate data-cc-animate-delay="' | append: card_delay | append: 's"' -%}
            <div
              class="nw-image__grid-item fade-in-up"
              style="--nw-image-anim-delay: {{ card_delay }}s;"
              {%- render 'animation-attrs', attrs: grid_anim_attrs, always: section_animate_always -%}
            >
              {%- render 'nw-image-item',
                block: block,
                loading: loading,
                onboarding: true,
                onboarding_index: i,
                animate_figure: false
              -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div
        class="swiper nw-image__slider{% unless has_blocks %} nw-image__slider--empty{% endunless %}"
        data-nw-image-slider
      >
        <div class="swiper-wrapper">
          {%- if has_blocks -%}
            {%- for block in section.blocks -%}
              {%- assign card_delay = forloop.index0 | times: 0.08 | plus: 0.1 -%}
              <div class="swiper-slide">
                {%- render 'nw-image-item',
                  block: block,
                  loading: loading,
                  animate_delay: card_delay,
                  animate_figure: true,
                  animate_always: section_animate_always
                -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..2) -%}
              {%- assign card_delay = i | minus: 1 | times: 0.08 | plus: 0.1 -%}
              <div class="swiper-slide">
                {%- render 'nw-image-item',
                  block: block,
                  loading: loading,
                  onboarding: true,
                  onboarding_index: i,
                  animate_delay: card_delay,
                  animate_figure: true,
                  animate_always: section_animate_always
                -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NW Image",
  "class": "shopify-section--nw-image",
  "disabled_on": {
    "groups": ["aside"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "seo",
      "label": "SEO",
      "info": "Optional. Uses for SEO title."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "default": "solid",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "linear_gradient",
          "label": "Linear gradient"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EBE9E2",
      "visible_if": "{{ section.settings.background_type == 'image' or section.settings.background_type == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(180deg, rgba(235, 233, 226, 1), rgba(255, 255, 255, 1) 100%)",
      "visible_if": "{{ section.settings.background_type == 'linear_gradient' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height desktop",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height mobile",
      "min": 0,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile",
          "info": "Optional. Uses desktop image when empty."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Image",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
