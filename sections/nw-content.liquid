{{ 'nw-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign focal_point = 'center center'
  if section.settings.image != blank and section.settings.image.presentation.focal_point
    assign focal_point = section.settings.image.presentation.focal_point
  endif

  assign section_background = 'transparent'
  assign show_media = false

  case section.settings.background_type
    when 'image'
      assign section_background = section.settings.background_color
      assign show_media = true
    when 'solid'
      assign section_background = section.settings.background_color
    when 'linear_gradient'
      assign section_background = section.settings.background_gradient
    when 'none'
      assign section_background = 'transparent'
  endcase

  case section.settings.heading_font_family
    when 'body'
      assign heading_font_family = 'var(--font-body-family)'
    when 'heading_italic'
      assign heading_font_family = 'var(--font-heading-family-italic)'
    when 'helvetica'
      assign heading_font_family = 'var(--font-helvetica-family)'
    else
      assign heading_font_family = 'var(--font-heading-family)'
  endcase

  case section.settings.subheading_font_family
    when 'heading'
      assign subheading_font_family = 'var(--font-heading-family)'
    when 'heading_italic'
      assign subheading_font_family = 'var(--font-heading-family-italic)'
    when 'helvetica'
      assign subheading_font_family = 'var(--font-helvetica-family)'
    else
      assign subheading_font_family = 'var(--font-body-family)'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .nw-content {
    --nw-content-min-height: {{ section.settings.min_height_desktop }}px;
    --nw-content-bg-fallback: {{ section.settings.background_color }};
    --nw-content-background: {{ section_background }};
    --nw-content-focal-point: {{ focal_point }};
    --nw-content-padding-top: {{ section.settings.padding_top_desktop }}px;
    --nw-content-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --nw-content-heading-color: {{ section.settings.heading_color }};
    --nw-content-heading-font-family: {{ heading_font_family }};
    --nw-content-heading-font-size: {{ section.settings.heading_font_size_desktop }}px;
    --nw-content-heading-font-weight: {{ section.settings.heading_font_weight }};
    --nw-content-subheading-font-family: {{ subheading_font_family }};
    --nw-content-subheading-font-size: {{ section.settings.subheading_font_size_desktop }}px;
    --nw-content-subheading-font-weight: {{ section.settings.subheading_font_weight }};
  }

  @media screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .nw-content {
      --nw-content-heading-font-size: {{ section.settings.heading_font_size_tablet }}px;
      --nw-content-subheading-font-size: {{ section.settings.subheading_font_size_tablet }}px;
    }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .nw-content {
      --nw-content-min-height: {{ section.settings.min_height_mobile }}px;
      --nw-content-padding-top: {{ section.settings.padding_top_mobile }}px;
      --nw-content-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      --nw-content-heading-font-size: {{ section.settings.heading_font_size_mobile }}px;
      --nw-content-subheading-font-size: {{ section.settings.subheading_font_size_mobile }}px;
    }
  }
{% endstyle %}

<section class="nw-content">
  {%- if show_media -%}
    <div
      class="nw-content__media fade-in-up"
      aria-hidden="true"
      {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.1s"' -%}
    >
      {%- liquid
        assign content_image = section.settings.image
        assign content_image_mobile = section.settings.mobile_image
        assign content_img_alt = content_image.alt | default: '' | escape
        assign content_img_mobile_alt = content_image_mobile.alt | default: content_img_alt | escape
      -%}
      {%- if content_image == blank -%}
        <div class="nw-content__image nw-content__image--placeholder">
          {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' -}}
        </div>
      {%- else -%}
        <img
          src="{{ content_image | image_url: width: 2560 }}"
          alt="{{ content_img_alt }}"
          class="nw-content__image nw-content__image--desktop"
          loading="{{ loading }}"
          width="{{ content_image.width }}"
          height="{{ content_image.height }}"
        >
        {%- if content_image_mobile != blank -%}
          <img
            src="{{ content_image_mobile | image_url: width: 1500 }}"
            alt="{{ content_img_mobile_alt }}"
            class="nw-content__image nw-content__image--mobile"
            loading="{{ loading }}"
            width="{{ content_image_mobile.width }}"
            height="{{ content_image_mobile.height }}"
          >
        {%- else -%}
          <img
            src="{{ content_image | image_url: width: 1500 }}"
            alt="{{ content_img_alt }}"
            class="nw-content__image nw-content__image--mobile"
            loading="{{ loading }}"
            width="{{ content_image.width }}"
            height="{{ content_image.height }}"
          >
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="container">
    <div class="nw-content__content">
      <div class="nw-content__inner">
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div
          class="nw-content__text fade-in-up"
          {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"' -%}
        >
          {%- if section.settings.heading != blank -%}
            <div class="nw-content__heading-wrap">
              <h2 class="nw-content__heading rte">
                {{- section.settings.heading -}}
              </h2>
            </div>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="nw-content__body rte">
              {{- section.settings.text -}}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_button -%}
        <div
          class="nw-content__actions fade-in-up nw-content-button"
          {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.45s"' -%}
        >
          {%- render 'nw-button',
            label: section.settings.button_label,
            url: section.settings.button_link,
            style_desktop: section.settings.button_style_desktop,
            style_mobile: section.settings.button_style_mobile,
            wrap_class: 'nw-content__button-wrap'
          -%}
        </div>
      {%- endif -%}
      </div>
    </div>
  </div>
</section>

