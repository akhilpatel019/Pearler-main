{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-quiz.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign step_count = section.settings.step_count | default: 5
  assign active_step_number = 1
  assign first_step_number = 1
  assign has_quiz_blocks = false
  for block in section.blocks
    if block.type == 'quiz_step_1' or block.type == 'quiz_step_2' or block.type == 'quiz_step_3' or block.type == 'quiz_step_4' or block.type == 'quiz_step_5' or block.type == 'quiz_step_6'
      assign has_quiz_blocks = true
      break
    endif
  endfor

  assign section_background = 'transparent'
  assign show_card_media = false
  assign focal_point = 'center center'
  if section.settings.image != blank and section.settings.image.presentation.focal_point
    assign focal_point = section.settings.image.presentation.focal_point
  endif

  case section.settings.background_type
    when 'image'
      assign section_background = section.settings.background_color
      assign show_card_media = true
    when 'solid'
      assign section_background = section.settings.background_color
    when 'linear_gradient'
      assign section_background = section.settings.background_gradient
    when 'none'
      assign section_background = 'transparent'
  endcase

  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .nw-quiz {
    --nw-quiz-padding-top: {{ section.settings.padding_top_desktop }}px;
    --nw-quiz-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --nw-quiz-card-radius: {{ section.settings.card_border_radius }}px;
    --nw-quiz-card-radius-mobile: {{ section.settings.card_border_radius_mobile }}px;
    --nw-quiz-min-height: {{ section.settings.min_height_desktop }}px;
    --nw-quiz-min-height-mobile: {{ section.settings.min_height_mobile }}px;
    --nw-quiz-background: {{ section_background }};
    --nw-quiz-bg-fallback: {{ section.settings.background_color }};
    --nw-quiz-focal-point: {{ focal_point }};
    --nw-quiz-text-color: {{ section.settings.text_color }};
    --nw-quiz-heading-color: {{ section.settings.heading_color }};
    --nw-quiz-progress-color: {{ section.settings.progress_color }};
    --nw-quiz-progress-marker-color: {{ section.settings.progress_marker_color }};
    --nw-quiz-rule-color: {{ section.settings.rule_color }};
    --nw-quiz-nav-border-color: {{ section.settings.nav_border_color }};
    --nw-quiz-option-border-color: {{ section.settings.option_border_color }};
    --nw-quiz-option-radius: {{ section.settings.option_border_radius }}px;
    --nw-quiz-option-radius-mobile: {{ section.settings.option_border_radius_mobile }}px;
    --nw-quiz-option-min-height: {{ section.settings.option_min_height_desktop }}px;
    --nw-quiz-option-min-height-mobile: {{ section.settings.option_min_height_mobile }}px;
    --nw-quiz-options-gap: {{ section.settings.options_gap_desktop }}px;
    --nw-quiz-options-gap-mobile: {{ section.settings.options_gap_mobile }}px;
    --nw-quiz-inner-padding-top: {{ section.settings.inner_padding_top_desktop }}px;
    --nw-quiz-inner-padding-bottom: {{ section.settings.inner_padding_bottom_desktop }}px;
    --nw-quiz-inner-padding-inline: {{ section.settings.inner_padding_inline_desktop }}px;
    --nw-quiz-inner-padding-top-mobile: {{ section.settings.inner_padding_top_mobile }}px;
    --nw-quiz-inner-padding-bottom-mobile: {{ section.settings.inner_padding_bottom_mobile }}px;
    --nw-quiz-inner-padding-inline-mobile: {{ section.settings.inner_padding_inline_mobile }}px;
    --nw-quiz-noise-opacity: {{ section.settings.noise_opacity | times: 0.01 }};
    --nw-quiz-padding-bottom-mobile: {{ section.settings.step_max_width }}px;
    --nw-quiz-padding-top-mobile: {{ section.settings.step_max_width_mobile }}px;
  }
{% endstyle %}

<section
  class="nw-quiz nw-step-{{ active_step_number }}"
  data-nw-quiz
  data-active-step="{{ active_step_number }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="container">
    <div class="nw-quiz__card">
      {%- if show_card_media -%}
        <div class="nw-quiz__media-bg fade-in-up" aria-hidden="true" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.1s"' -%}>
          {%- liquid
            assign card_image = section.settings.image
            assign card_image_mobile = section.settings.mobile_image
          -%}
          {%- if card_image == blank -%}
            <div class="nw-quiz__media-bg-image nw-quiz__media-bg-image--placeholder">
              {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' -}}
            </div>
          {%- else -%}
            <img
              src="{{ card_image | image_url: width: 2560 }}"
              alt=""
              class="nw-quiz__media-bg-image nw-quiz__media-bg-image--desktop"
              loading="{{ loading }}"
              width="{{ card_image.width }}"
              height="{{ card_image.height }}"
            >
            {%- if card_image_mobile != blank -%}
              <img
                src="{{ card_image_mobile | image_url: width: 1500 }}"
                alt=""
                class="nw-quiz__media-bg-image nw-quiz__media-bg-image--mobile"
                loading="{{ loading }}"
                width="{{ card_image_mobile.width }}"
                height="{{ card_image_mobile.height }}"
              >
            {%- else -%}
              <img
                src="{{ card_image | image_url: width: 1500 }}"
                alt=""
                class="nw-quiz__media-bg-image nw-quiz__media-bg-image--mobile"
                loading="{{ loading }}"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
              >
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="nw-quiz__card-inner">
        <ol class="nw-quiz__progress" aria-label="{{ section.settings.progress_aria_label | escape }}">
          {%- for i in (1..step_count) -%}
            {%- liquid
              assign step_label_key = 'step_' | append: i | append: '_label'
              assign step_label = section.settings[step_label_key]
              assign progress_class = ''
            -%}
            <li class="nw-quiz__progress-item {{ progress_class }}" data-nw-quiz-progress-step="{{ i }}">
              <span class="nw-quiz__progress-label">{{ step_label | escape }}</span>
              <span class="nw-quiz__progress-marker" aria-hidden="true"></span>
            </li>
          {%- endfor -%}
        </ol>

        <hr class="nw-quiz__rule" aria-hidden="true">

        <div class="nw-quiz__main">
          <div class="nw-quiz__step-intro" data-nw-quiz-step-intro>
            {%- if has_quiz_blocks == false -%}
              <div class="nw-quiz__step-header nw-step-1 is-active" data-nw-quiz-step-header data-nw-quiz-step="1">
                <h2 class="nw-quiz__step-heading">Select Your Style</h2>
              </div>
            {%- else -%}
              {%- assign quiz_step_order = 'quiz_step_1,quiz_step_2,quiz_step_3,quiz_step_4,quiz_step_5,quiz_step_6' | split: ',' -%}
              {%- for step_type_name in quiz_step_order -%}
                {%- for block in section.blocks -%}
                  {%- if block.type != step_type_name -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- liquid
                    assign step_active = false
                    if step_type_name == 'quiz_step_1'
                      assign step_active = true
                    endif
                  -%}
                  {%- render 'nw-quiz-render-block', block: block, step_active: step_active, part: 'header' -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="nw-quiz__body" data-nw-quiz-body>
            {%- if section.settings.show_desktop_nav -%}
              <button
                type="button"
                class="nw-quiz__nav nw-quiz__nav--prev"
                data-nw-quiz-prev
                aria-label="{{ section.settings.prev_button_label | escape }}"
                disabled
              >
                <span class="icon icon--small has-ltr-icon">{% render 'icon-chevron-left', stroke_width: 1.2 %}</span>
              </button>
              <button
                type="button"
                class="nw-quiz__nav nw-quiz__nav--next"
                data-nw-quiz-next
                aria-label="{{ section.settings.next_button_label | escape }}"
                disabled
              >
                <span class="icon icon--small has-ltr-icon">{% render 'icon-chevron-right', stroke_width: 1.2 %}</span>
              </button>
            {%- endif -%}

            {%- if has_quiz_blocks == false -%}
              <div class="nw-quiz__step nw-step-1 is-active" data-nw-quiz-step="1" data-step-type="choices">
                <ul class="nw-quiz__options" role="list">
                  <li>
                    <button type="button" class="nw-quiz__option" disabled>
                      <div class="nw-quiz__option-label rte"><p>Option</p></div>
                    </button>
                  </li>
                </ul>
              </div>
            {%- else -%}
              {%- for step_type_name in quiz_step_order -%}
                {%- for block in section.blocks -%}
                  {%- if block.type != step_type_name -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- liquid
                    assign step_active = false
                    if step_type_name == 'quiz_step_1'
                      assign step_active = true
                    endif
                  -%}
                  {%- render 'nw-quiz-render-block', block: block, step_active: step_active, part: 'content' -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_mobile_back -%}
          <div class="nw-quiz__footer">
            <button
              type="button"
              class="nw-button nw-button--d-style_3 nw-button--m-style_3"
              data-nw-quiz-back 
              disabled
            >
              {{- section.settings.back_button_label | escape -}}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NW Quiz",
  "class": "shopify-section--nw-quiz",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Progress labels"
