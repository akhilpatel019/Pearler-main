    },
    {
      "type": "range",
      "id": "step_count",
      "label": "Number of progress steps",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "step_1_label",
      "label": "Step 1 label",
      "default": "01"
    },
    {
      "type": "text",
      "id": "step_2_label",
      "label": "Step 2 label",
      "default": "02"
    },
    {
      "type": "text",
      "id": "step_3_label",
      "label": "Step 3 label",
      "default": "03"
    },
    {
      "type": "text",
      "id": "step_4_label",
      "label": "Step 4 label",
      "default": "04"
    },
    {
      "type": "text",
      "id": "step_5_label",
      "label": "Step 5 label",
      "default": "05"
    },
    {
      "type": "text",
      "id": "step_6_label",
      "label": "Step 6 label",
      "default": "06"
    },
    {
      "type": "text",
      "id": "step_7_label",
      "label": "Step 7 label",
      "default": "07"
    },
    {
      "type": "text",
      "id": "step_8_label",
      "label": "Step 8 label",
      "default": "08"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product quiz"
    },
    {
      "type": "text",
      "id": "progress_aria_label",
      "label": "Progress bar accessibility label",
      "default": "Quiz progress"
    },
    {
      "type": "header",
      "content": "Navigation (design)"
    },
    {
      "type": "checkbox",
      "id": "show_desktop_nav",
      "label": "Show desktop arrow controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_back",
      "label": "Show mobile back button",
      "default": true
    },
    {
      "type": "text",
      "id": "back_button_label",
      "label": "Mobile back button label",
      "default": "BACK"
    },
    {
      "type": "text",
      "id": "prev_button_label",
      "label": "Previous arrow label",
      "default": "Previous step"
    },
    {
      "type": "text",
      "id": "next_button_label",
      "label": "Next arrow label",
      "default": "Next step"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "default": "linear_gradient",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "linear_gradient",
          "label": "Linear gradient"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Card background image (mobile)",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#4b5362",
      "visible_if": "{{ section.settings.background_type == 'image' or section.settings.background_type == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(145deg, rgba(75, 83, 98, 1) 0%, rgba(58, 66, 79, 1) 45%, rgba(109, 124, 145, 1) 100%)",
      "visible_if": "{{ section.settings.background_type == 'linear_gradient' }}"
    },
    {
      "type": "range",
      "id": "noise_opacity",
      "label": "Background texture opacity",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "%",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Inactive step number",
      "default": "rgba(255, 255, 255, 0.55)"
    },
    {
      "type": "color",
      "id": "progress_marker_color",
      "label": "Inactive step marker",
      "default": "rgba(255, 255, 255, 0.45)"
    },
    {
      "type": "color",
      "id": "rule_color",
