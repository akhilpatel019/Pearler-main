<link rel="stylesheet" href="{{ 'collapsible-tabs.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
{{ 'nw-collapsible-tabs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign focal_point = 'center center'
  if section.settings.image != blank and section.settings.image.presentation.focal_point
    assign focal_point = section.settings.image.presentation.focal_point
  endif

  assign section_background = 'transparent'
  assign show_media = false

  case section.settings.background_type
    when 'image'
      assign section_background = section.settings.background_color
      assign show_media = true
    when 'solid'
      assign section_background = section.settings.background_color
    when 'linear_gradient'
      assign section_background = section.settings.background_gradient
    when 'none'
      assign section_background = 'transparent'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .nw-collapsible-tabs {
    --nw-collapsible-tabs-bg-fallback: {{ section.settings.background_color }};
    --nw-collapsible-tabs-background: {{ section_background }};
    --nw-collapsible-tabs-focal-point: {{ focal_point }};
    --nw-collapsible-tabs-padding-top: {{ section.settings.padding_top_desktop }}px;
    --nw-collapsible-tabs-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --nw-collapsible-tabs-heading-color: {{ section.settings.heading_color }};
    --nw-collapsible-tabs-text-color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .nw-collapsible-tabs {
      --nw-collapsible-tabs-padding-top: {{ section.settings.padding_top_mobile }}px;
      --nw-collapsible-tabs-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="nw-collapsible-tabs">
  {%- if show_media -%}
    <div class="nw-collapsible-tabs__media-bg" aria-hidden="true">
      {%- liquid
        assign section_image = section.settings.image
        assign section_image_mobile = section.settings.mobile_image
      -%}
      {%- if section_image == blank -%}
        <div class="nw-collapsible-tabs__media-bg-image nw-collapsible-tabs__media-bg-image--placeholder">
          {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' -}}
        </div>
      {%- else -%}
        <img
          src="{{ section_image | image_url: width: 2560 }}"
          alt=""
          class="nw-collapsible-tabs__media-bg-image nw-collapsible-tabs__media-bg-image--desktop"
          loading="{{ loading }}"
          width="{{ section_image.width }}"
          height="{{ section_image.height }}"
        >
        {%- if section_image_mobile != blank -%}
          <img
            src="{{ section_image_mobile | image_url: width: 1500 }}"
            alt=""
            class="nw-collapsible-tabs__media-bg-image nw-collapsible-tabs__media-bg-image--mobile"
            loading="{{ loading }}"
            width="{{ section_image_mobile.width }}"
            height="{{ section_image_mobile.height }}"
          >
        {%- else -%}
          <img
            src="{{ section_image | image_url: width: 1500 }}"
            alt=""
            class="nw-collapsible-tabs__media-bg-image nw-collapsible-tabs__media-bg-image--mobile"
            loading="{{ loading }}"
            width="{{ section_image.width }}"
            height="{{ section_image.height }}"
          >
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="nw-collapsible-tabs__content">
    <div class="container" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      <div class="collapsible-tabs">
        {% if section.settings.title != blank %}
          <h3 class="collapsible-tabs__heading collapsible-tabs__content" id="faq-{{ section.settings.title | handle }}">{{ section.settings.title | escape }}</h3>
        {% endif %}

        {%- for block in section.blocks -%}
          <div class="collapsible-tabs__block" {{ block.shopify_attributes }}>
            {% if block.type == 'content' %}
              <div class="collapsible-tabs__text collapsible-tabs__content rte">{{ block.settings.content }}</div>

            {% elsif block.type == 'button' %}
              <div class="collapsible-tabs__button collapsible-tabs__content">
                <a class="btn btn--primary btn--link" href="{{ block.settings.link }}"><span class="btn__text">{{ block.settings.title | escape }}</span></a>
              </div>

            {% elsif block.type == 'question' %}
              <div class="collapsible-tabs__tab">
                <details-disclosure>
                  <details class="disclosure"{% if section.settings.open_tab %} open{% endif %}>
                    <summary class="disclosure__title">
                      {{- block.settings.title | escape -}}
                    </summary>
                    <div class="disclosure__panel has-motion">
                      <div class="disclosure__content rte">
                        {{- block.settings.answer -}}
                      </div>
                    </div>
                  </details>
                </details-disclosure>
              </div>
            {% endif %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% if section.settings.enable_faq_schema %}
  <script type="application/ld+json">
    {%- capture faq_json -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' and block.settings.title != blank and block.settings.answer != blank -%}
          {
            "@type": "Question",
            "name": {{ block.settings.title | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          },
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if faq_json != blank -%}
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {{ faq_json | remove_last: ',' }}
      ]
    }
    {%- endif -%}
  </script>
{% endif %}

{% schema %}
{
  "name": "Collapsible tabs",
  "class": "section-collapsible-tabs shopify-section--nw-collapsible-tabs",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Collapsible tabs"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "alpha": true,
      "default": "#04022B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "alpha": true,
      "default": "#04022B"
    },
    {
      "type": "checkbox",
      "id": "open_tab",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Enable FAQ structured data",
      "info": "Adds FAQPage data to the page for SEO",
      "default": false
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "default": "solid",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "linear_gradient",
          "label": "Linear gradient"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EBE9E2",
      "visible_if": "{{ section.settings.background_type == 'image' or section.settings.background_type == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(180deg, rgba(235, 233, 226, 1), rgba(255, 255, 255, 1) 100%)",
      "visible_if": "{{ section.settings.background_type == 'linear_gradient' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    },
    {
      "type": "content",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible tabs",
      "category": "Info",
      "settings": {
      },
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
