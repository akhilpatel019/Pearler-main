{{ 'nw-section-header.css' | asset_url | stylesheet_tag }}
{{ 'nw-product-card.css' | asset_url | stylesheet_tag }}
{{ 'nw-bestseller.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-product-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'nw-bestseller.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign max_slides = section.settings.max_slides
  assign slides_rendered = 0

  assign use_product_blocks = false
  if section.settings.product_source == 'collection'
    if section.settings.collection != blank
      assign source_collection = collections[section.settings.collection]
      assign source_products = source_collection.products
    endif
  elsif section.settings.product_source == 'product_list'
    assign use_product_blocks = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .nw-bestseller {
    --nw-bestseller-bg: {{ section.settings.background_color }};
    --nw-bestseller-text: {{ section.settings.text_color }};
    --nw-section-header-color: {{ section.settings.heading_color }};
    --nw-product-card-text-color: {{ section.settings.text_color }};
    --nw-bestseller-padding-top: {{ section.settings.padding_top_desktop }}px;
    --nw-bestseller-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .nw-bestseller {
      --nw-bestseller-padding-top: {{ section.settings.padding_top_mobile }}px;
      --nw-bestseller-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="nw-bestseller">
  <div class="container">
    <div class="nw-bestseller-inner">
      {%- render 'nw-section-header', heading: section.settings.heading, animate_delay: '0.15s' -%}

      <div class="swiper nw-bestseller__slider" data-nw-bestseller-slider>
        <div class="swiper-wrapper">
          {%- if use_product_blocks -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'bestseller_product' and slides_rendered < max_slides -%}
                {%- assign block_product = block.settings.product -%}
                {%- if block_product != blank -%}
                  {%- assign slides_rendered = slides_rendered | plus: 1 -%}
                  {%- liquid
                    assign delay_hundredths = slides_rendered | minus: 1 | times: 12 | plus: 35
                    assign delay_whole = delay_hundredths | divided_by: 100
                    assign delay_frac = delay_hundredths | modulo: 100
                    if delay_whole == 0
                      if delay_frac < 10
                        assign slide_anim_delay = '0.0' | append: delay_frac | append: 's'
                      else
                        assign slide_anim_delay = '0.' | append: delay_frac | append: 's'
                      endif
                    elsif delay_frac < 10
                      assign slide_anim_delay = delay_whole | append: '.0' | append: delay_frac | append: 's'
                    else
                      assign slide_anim_delay = delay_whole | append: '.' | append: delay_frac | append: 's'
                    endif
                  -%}
                  {%- render 'nw-bestseller-slide',
                    product: block_product,
                    animate_delay: slide_anim_delay,
                    variant_options: block.settings.variant_options,
                    custom_title: block.settings.custom_title,
                    shopify_attributes: block.shopify_attributes
                  -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if slides_rendered == 0 -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign delay_hundredths = forloop.index0 | times: 12 | plus: 35
                  assign delay_whole = delay_hundredths | divided_by: 100
                  assign delay_frac = delay_hundredths | modulo: 100
                  if delay_whole == 0
                    if delay_frac < 10
                      assign slide_anim_delay = '0.0' | append: delay_frac | append: 's'
                    else
                      assign slide_anim_delay = '0.' | append: delay_frac | append: 's'
                    endif
                  elsif delay_frac < 10
                    assign slide_anim_delay = delay_whole | append: '.0' | append: delay_frac | append: 's'
                  else
                    assign slide_anim_delay = delay_whole | append: '.' | append: delay_frac | append: 's'
                  endif
                  assign slide_animate_attrs = 'data-cc-animate data-cc-animate-delay="' | append: slide_anim_delay | append: '"'
                -%}
                <div class="swiper-slide fade-in-up" {%- render 'animation-attrs', attrs: slide_animate_attrs -%}>
                  {%- render 'nw-product-card', onboarding: true, onboarding_index: i -%}
                </div>
              {%- endfor -%}
              {%- assign slides_rendered = 3 -%}
            {%- endif -%}
          {%- elsif source_products == blank -%}
            {%- for i in (1..3) -%}
              {%- liquid
                assign delay_hundredths = forloop.index0 | times: 12 | plus: 35
                assign delay_whole = delay_hundredths | divided_by: 100
                assign delay_frac = delay_hundredths | modulo: 100
                if delay_whole == 0
                  if delay_frac < 10
                    assign slide_anim_delay = '0.0' | append: delay_frac | append: 's'
                  else
                    assign slide_anim_delay = '0.' | append: delay_frac | append: 's'
                  endif
                elsif delay_frac < 10
                  assign slide_anim_delay = delay_whole | append: '.0' | append: delay_frac | append: 's'
                else
                  assign slide_anim_delay = delay_whole | append: '.' | append: delay_frac | append: 's'
                endif
                assign slide_animate_attrs = 'data-cc-animate data-cc-animate-delay="' | append: slide_anim_delay | append: '"'
              -%}
              <div class="swiper-slide fade-in-up" {%- render 'animation-attrs', attrs: slide_animate_attrs -%}>
                {%- render 'nw-product-card', onboarding: true, onboarding_index: i -%}
              </div>
            {%- endfor -%}
            {%- assign slides_rendered = 3 -%}
          {%- else -%}
            {%- for product in source_products -%}
              {%- if slides_rendered >= max_slides -%}
                {%- break -%}
              {%- endif -%}
              {%- assign slides_rendered = slides_rendered | plus: 1 -%}
              {%- liquid
                assign delay_hundredths = slides_rendered | minus: 1 | times: 12 | plus: 35
                assign delay_whole = delay_hundredths | divided_by: 100
                assign delay_frac = delay_hundredths | modulo: 100
                if delay_whole == 0
                  if delay_frac < 10
                    assign slide_anim_delay = '0.0' | append: delay_frac | append: 's'
                  else
                    assign slide_anim_delay = '0.' | append: delay_frac | append: 's'
                  endif
                elsif delay_frac < 10
                  assign slide_anim_delay = delay_whole | append: '.0' | append: delay_frac | append: 's'
                else
                  assign slide_anim_delay = delay_whole | append: '.' | append: delay_frac | append: 's'
                endif
              -%}
              {%- render 'nw-bestseller-slide', product: product, animate_delay: slide_anim_delay -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- liquid
        assign slide_count = slides_rendered
        if slide_count < 1
          assign slide_count = 1
        endif
        assign actions_hundredths = slide_count | times: 12 | plus: 47
        assign actions_whole = actions_hundredths | divided_by: 100
        assign actions_frac = actions_hundredths | modulo: 100
        if actions_whole == 0
          if actions_frac < 10
            assign actions_anim_delay = '0.0' | append: actions_frac | append: 's'
          else
            assign actions_anim_delay = '0.' | append: actions_frac | append: 's'
          endif
        elsif actions_frac < 10
          assign actions_anim_delay = actions_whole | append: '.0' | append: actions_frac | append: 's'
        else
          assign actions_anim_delay = actions_whole | append: '.' | append: actions_frac | append: 's'
        endif
        assign feature_hundredths = actions_hundredths | plus: 15
        assign feature_whole = feature_hundredths | divided_by: 100
        assign feature_frac = feature_hundredths | modulo: 100
        if feature_whole == 0
          if feature_frac < 10
            assign feature_anim_delay = '0.0' | append: feature_frac | append: 's'
          else
            assign feature_anim_delay = '0.' | append: feature_frac | append: 's'
          endif
        elsif feature_frac < 10
          assign feature_anim_delay = feature_whole | append: '.0' | append: feature_frac | append: 's'
        else
          assign feature_anim_delay = feature_whole | append: '.' | append: feature_frac | append: 's'
        endif
      -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        {%- capture actions_animate_attrs -%}data-cc-animate data-cc-animate-delay="{{ actions_anim_delay }}"{%- endcapture -%}
        <div
          class="nw-bestseller__actions fade-in-up"
          {%- render 'animation-attrs', attrs: actions_animate_attrs -%}
        >
          {%- render 'nw-button',
            label: section.settings.button_1_label,
            url: section.settings.button_1_link,
            style_desktop: section.settings.button_1_style_desktop,
            style_mobile: section.settings.button_1_style_mobile
          -%}
          {%- render 'nw-button',
            label: section.settings.button_2_label,
            url: section.settings.button_2_link,
            style_desktop: section.settings.button_2_style_desktop,
            style_mobile: section.settings.button_2_style_mobile
          -%}
        </div>
      {%- endif -%}

      {%- if section.settings.feature_image != blank or section.settings.feature_image_mobile != blank -%}
        {%- liquid
          assign feature_desktop = section.settings.feature_image
          assign feature_mobile = section.settings.feature_image_mobile
          if feature_mobile == blank
            assign feature_mobile = feature_desktop
          endif
          if feature_desktop == blank
            assign feature_desktop = feature_mobile
          endif
          assign feature_alt = feature_desktop.alt | default: feature_mobile.alt | escape
        -%}
        {%- capture feature_animate_attrs -%}data-cc-animate data-cc-animate-delay="{{ feature_anim_delay }}"{%- endcapture -%}
        <div
          class="nw-bestseller__feature fade-in-up"
          {%- render 'animation-attrs', attrs: feature_animate_attrs -%}
        >
          {%- if feature_desktop != blank -%}
            <img
              src="{{ feature_desktop | image_url }}"
              alt="{{ feature_alt }}"
              width=""
              height=""
              loading="lazy"
              class="nw-bestseller__feature-image nw-bestseller__feature-image--desktop"
            >
          {%- endif -%}
          {%- if feature_mobile != blank -%}
            <img
              src="{{ feature_mobile | image_url }}"
              alt="{{ feature_alt }}"
              width=""
              height=""
              loading="lazy"
              class="nw-bestseller__feature-image nw-bestseller__feature-image--mobile"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NW Bestseller",
  "class": "shopify-section--nw-bestseller",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "Collection"
        },
        {
          "value": "product_list",
          "label": "Product list (blocks)"
        }
      ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
    },
    {
      "type": "paragraph",
      "content": "Add Product blocks below and choose a product for each slide.",
      "visible_if": "{{ section.settings.product_source == 'product_list' }}"
    },
    {
      "type": "range",
      "id": "max_slides",
      "label": "Maximum products",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "alpha": true,
      "default": "#04022B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "alpha": true,
      "default": "#04022B"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "alpha": true,
      "default": "#EBE9E2"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature image"
    },
    {
      "type": "image_picker",
      "id": "feature_image_mobile",
      "label": "Feature image mobile"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop Mens"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_1_style_desktop",
      "label": "Button 1 style desktop",
      "default": "style_1",
      "options": [
        {
          "value": "style_1",
          "label": "Solid navy"
        },
        {
          "value": "style_2",
          "label": "Outline navy"
        },
        {
          "value": "style_3",
          "label": "Outline cream"
        },
        {
          "value": "style_4",
          "label": "Solid cream"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_1_style_mobile",
      "label": "Button 1 style mobile",
      "default": "style_1",
      "options": [
        {
          "value": "style_1",
          "label": "Solid navy"
        },
        {
          "value": "style_2",
          "label": "Outline navy"
        },
        {
          "value": "style_3",
          "label": "Outline cream"
        },
        {
          "value": "style_4",
          "label": "Solid cream"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Shop Womens"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_2_style_desktop",
      "label": "Button 2 style desktop",
      "default": "style_1",
      "options": [
        {
          "value": "style_1",
          "label": "Solid navy"
        },
        {
          "value": "style_2",
          "label": "Outline navy"
        },
        {
          "value": "style_3",
          "label": "Outline cream"
        },
        {
          "value": "style_4",
          "label": "Solid cream"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_2_style_mobile",
      "label": "Button 2 style mobile",
      "default": "style_2",
      "options": [
        {
          "value": "style_1",
          "label": "Solid navy"
        },
        {
          "value": "style_2",
          "label": "Outline navy"
        },
        {
          "value": "style_3",
          "label": "Outline cream"
        },
        {
          "value": "style_4",
          "label": "Solid cream"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "bestseller_product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "textarea",
          "id": "variant_options",
          "label": "Variant options",
          "info": "One option value per line, in product option order (e.g. Size, Length, Color). Comma-separated on one line also works. Leave blank for the first available variant."
        },
        {
          "type": "textarea",
          "id": "custom_title",
          "label": "Custom title",
          "info": "Optional. Plain text or [Option name] tokens, e.g. [Length] / [Color]. Uses the variant selected above. Leave blank to show variant options as the title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Bestseller",
      "blocks": [
        {
          "type": "bestseller_product"
        },
        {
          "type": "bestseller_product"
        },
        {
          "type": "bestseller_product"
        }
      ]
    }
  ],
  "max_blocks": 24
}
{% endschema %}
