{{ 'nw-popup.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'size-guide.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
<script src="{{ 'nw-popup.js' | asset_url }}" defer></script>
<script src="{{ 'size-guide.js' | asset_url }}" defer></script>
<script src="{{ 'tabs.js' | asset_url }}" defer></script>

{%- liquid
  assign popup_id = section.settings.popup_id | strip
-%}

{%- capture nw_popup_footer -%}
  {%- if section.settings.show_footer -%}
    <div class="size-guide__footer rte mt-8 py-3 px-6 small-text nw-popup__footer" style="background: {{ section.settings.footer_bg_color }};
                            color: {{ section.settings.footer_text_color }};
                            --link-color: {{ section.settings.footer_text_color.rgb }}">
      {{- section.settings.footer_text -}}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if popup_id != blank -%}
  <modal-dialog
    class="modal modal--for-product nw-popup invisible fixed top-0 left-0 w-full h-full flex items-center justify-center"
    id="{{ popup_id | escape }}"
    role="dialog"
    aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ popup_id | escape }}{% endif %}"
    aria-modal="true"
    tabindex="-1">
    <div class="modal__window relative bg-theme-bg text-theme-text text-start overflow-hidden has-motion">
      <button type="button" class="modal__close-btn absolute js-close-modal">
        {% render 'icon-close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>

      {%- if section.settings.heading != blank -%}
        <h2 class="h3 modal__edge-title nw-popup__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <hr class="nw-popup__divider">

      <div class="modal__content modal__content--no-bottom flex-auto h-full nw-popup__content">
        {%- if section.settings.under_heading != blank -%}
          <div class="rte nw-popup__intro">{{ section.settings.under_heading }}</div>
        {%- endif -%}

        {%- capture block_html -%}{% content_for 'blocks' %}{%- endcapture -%}
        {%- assign block_html_stripped = block_html | strip -%}

        {%- if block_html_stripped != blank -%}
          <size-guide class="size-guide block nw-popup__size-guide{% if section.settings.enable_row_highlight %} size-guide--row-highlight{% endif %}" data-section-id="{{ section.id }}">
            {%- liquid
              assign tab_count = block_html | split: 'class="tablist__tab"' | size | minus: 1
            -%}
            {%- if tab_count < 2 -%}
              <div class="size-guide__content mt-6 mb-8">
                {{- block_html | replace: 'role="tabpanel" tabindex="0" hidden aria-labelledby', 'data-aria-labelledby' -}}
              </div>
            {%- else -%}
              <tabbed-content class="size-guide__content block mt-4 mb-8">
                <div class="tablist mb-6">
                  <div class="tablist__scroller flex" role="tablist">
                    {%- liquid
                      assign split_block_html = block_html | split: '<template data-tab-button>'
                      for html in split_block_html offset: 1
                        assign button_html = html | split: '</template>' | first
                        echo button_html
                      endfor
                    -%}
                  </div>
                </div>
                {{- block_html -}}
              </tabbed-content>
            {%- endif -%}
          </size-guide>
        {%- else -%}
          <div class="rte">
            {%- if section.settings.page != blank -%}
              {{ section.settings.page.content }}
            {%- else -%}
              {{ section.settings.content }}
            {%- endif -%}
          </div>
        {%- endif -%}

        {{- nw_popup_footer -}}
      </div>
    </div>
  </modal-dialog>
{%- elsif request.design_mode -%}
  <div class="container lightly-spaced-row">
    <p class="small-text">Add a Popup ID in section settings so triggers can open this modal.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NW Popup",
  "class": "section-nw-popup",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a unique Popup ID, then use the same value on triggers: data-nw-popup-target on links/buttons, or data-target-id on open-or-scroll-to."
    },
    {
      "type": "text",
      "id": "popup_id",
      "label": "Popup ID",
      "info": "HTML id on the modal. Example: pearler-size-guide",
      "default": "pearler-size-guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pearler Size Guide"
    },
    {
      "id": "under_heading",
      "type": "richtext",
      "label": "Text under heading"
    },
    {
      "type": "header",
      "content": "Fallback content"
    },
    {
      "type": "paragraph",
      "content": "Used only when no blocks are added below. Add Tab blocks for size charts (same as Size guide section)."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>For the best fit, select your current shoe size. If you are between sizes, we recommend choosing the smaller size.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "Content from page",
      "info": "Optional. Replaces the rich text above when selected."
    },
    {
      "type": "header",
      "content": "Tables"
    },
    {
      "id": "enable_row_highlight",
      "type": "checkbox",
      "label": "Show alternating row highlight",
      "default": true
    },
    {
      "type": "header",
      "content": "Popup footer"
    },
    {
      "id": "show_footer",
      "type": "checkbox",
      "label": "Show footer",
      "default": false
    },
    {
      "id": "footer_text",
      "type": "inline_richtext",
      "label": "Footer text",
      "default": "Not sure? Feel free to contact our friendly team for help."
    },
    {
      "id": "footer_bg_color",
      "type": "color",
      "label": "Footer background color",
      "default": "#000000"
    },
    {
      "id": "footer_text_color",
      "type": "color",
      "label": "Footer text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [{ "type": "size-guide-tab" }],
  "presets": [
    {
      "name": "NW Popup",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "size-guide-tab",
          "blocks": [
            {
              "type": "size-guide-content",
              "settings": {
                "content": "<p>For the best fit, select your current shoe size. If you are between sizes, we recommend choosing the smaller size.</p>"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
